:"MEMBERSHIP","maxQuantity":null,"stats":{"__typename":"TierStatsType","id":7526,"availableQuantity":2147483647,"totalDonated":3904500,"totalRecurringDonations":0,"contributors":{"__typename":"ContributorsStats","id":"7526","all":1,"users":0,"organizations":1}},"contributors":[{"__typename":"Contributor","id":"69553","image":"https://images.opencollective.com/elastic/dce5929/logo/64.png","collectiveSlug":"elastic","name":"Elastic","type":"ORGANIZATION","isGuest":false,"hasPublicProfile":true}]},{"__typename":"Tier","id":31794,"name":"Platinum Sponsor","slug":"platinum-sponsor","description":"Sponsors donating 1,000 USD monthly are entitled to get shown on the curl web site's sponsor page at \"PLATINUM level\". (mail daniel at haxx.se with logo and link)\n\nThis also entitles the name+logo to be visualized (in a smaller version) on the curl website front page (curl.se).","useStandalonePage":true,"goal":null,"interval":"month","currency":"USD","amount":100000,"minimumAmount":null,"button":null,"amountType":"FIXED","endsAt":null,"type":"MEMBERSHIP","maxQuantity":null,"stats":{"__typename":"TierStatsType","id":31794,"availableQuantity":2147483647,"totalDonated":100000,"totalRecurringDonations":0,"contributors":{"__typename":"ContributorsStats","id":"31794","all":1,"users":1,"organizations":0}},"contributors":[{"__typename":"Contributor","id":"669970","image":"https://images.opencollective.com/twicsy-followers/avatar/64.png","collectiveSlug":"twicsy-followers","name":"Andre Vaughn","type":"USER","isGuest":false,"hasPublicProfile":true}]}],"events":[],"projects":[],"admins":[{"__typename":"Member","id":14711},{"__typename":"Member","id":30621},{"__typename":"Member","id":30622}],"connectedCollectives":[],"plan":{"__typename":"PlanType","id":14622,"hostedCollectives":0}}}},"scripts":{},"locale":"en","__N_SSP":true,"__APOLLO_STATE__":{"CollectiveFeatures:re0adkjr-v8xwm697-7akq7z5n-4l93bgoy":{"__typename":"CollectiveFeatures","id":"re0adkjr-v8xwm697-7akq7z5n-4l93bgoy","ABOUT