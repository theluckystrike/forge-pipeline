onthly may be entitled to get shown on the curl web site's sponsor page at \"Silver level\". (mail daniel at haxx.se with logo and link)\n\nSponsors may be denied a website presence for example if involved with drugs, gambling, pornography, social media manipulation etc.\n\nPlease contact Daniel and deliver a suitable logo image for that purpose: 500 pixels wide","useStandalonePage":true,"goal":null,"interval":"month","currency":"USD","amount":10000,"minimumAmount":null,"button":null,"amountType":"FIXED","endsAt":null,"type":"MEMBERSHIP","maxQuantity":null,"stats":{"__ref":"TierStatsType:4080"},"contributors({\"limit\":4})":[{"__ref":"Contributor:4087"},{"__ref":"Contributor:7410"},{"__ref":"Contributor:59067"},{"__ref":"Contributor:71557"}]},"ContributorsStats:7526":{"__typename":"ContributorsStats","id":"7526","all":1,"users":0,"organizations":1},"TierStatsType:7526":{"__typename":"TierStatsType","id":7526,"availableQuantity":2147483647,"totalDonated":3904500,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:7526"}},"Tier:{\"id\":7526}":{"__typename":"Tier","id":7526,"name":"Gold Sponsor","slug":"gold-sponsor","description":"Sponsors donating at least 500USD monthly may be entitled to get shown on the curl web site's sponsor page at \"GOLD level\". (mail daniel at haxx.se with logo and link)\n\nSponsors may be denied a website presence for example if involved with drugs, gambling, pornography, social media manipulation etc.\n\n(Please contact Daniel and deliver a suitable logo image for that purpose: 500 pixels wide or preferably an SVG formatted one)","useStandalonePage":true,"goal":null,"interval":"month","currency":"USD","amount":50000,"minimumAmount":null,"button":null,"amountType":"FIXED","endsAt":null,"type":"MEMBERSHIP","maxQuantity":null,"stats":{"__ref":"TierStatsType:7526"},"contributors({\"limit\":4})":[{"__ref":"Contributor:69553"}]},"ContributorsStats:31794":{"__typename":"ContributorsStats","id":"31794","all":1,"users":1,"organizations":0},"TierStatsType:31794":{"__typename":"TierStatsType","id":31794,"availableQuantity":2147483647,"totalDonated":100000,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:31794"}},"Tier:{\"id\":31794}":{"__typename":"Tier","id":31794,"name":"Platinum Sponsor","slug":"platinum-sponsor","description":"Sponsors donating 1,000 USD monthly are entitled to get shown on the curl web site's sponsor page at \"PLATINUM level\". (mail daniel at haxx.se with logo and link)\n\nThis also entitles the name+logo to be visualized (in a smaller version) on the curl website front page (curl.se).","useStandalonePage":true,"goal":null,"interval":"month","currency":"USD","amount":100000,"minimumAmount":null,"button":null,"amountType":"FIXED","endsAt":null,"type":"MEMBERSHIP","maxQuantity":null,"stats":{"__ref":"TierStatsType:31794"},"contributors({\"limit\":4})":[{"__ref":"Contributor:669970"}]},"Member:14711":{"__typename":"Member","id":14711},"Member:30621":{"__typename":"Member","id":30621},"Member:30622":{"__typename":"Member","id":30622},"PlanType:14622":{"__typename":"PlanType","id":14622,"hostedCollectives":0},"Collective:14622":{"__typename":"Collective","id":14622,"idV2":"re0adkjr-v8xwm697-7akq7z5n-4l93bgoy","slug":"curl","path":"/curl","name":"curl","hasHosting":false,"description":"client-side internet transfers","longDescription":"\u003cdiv\u003eA command line tool and library for transferring data with URL syntax.\u003cbr /\u003e\u003cbr /\u003ePlease note that sponsorships and donations are exactly that: donations to the curl project. They are used to help and further the project as the project leadership deems best. No goods or services are expected or promised in return. Any requests for refunds for such purposes will be rejected.\u003cbr /\u003e\u003cbr /\u003eWe love your sponsorship!\u003c/div\u003e","backgroundImage":null,"backgroundImageUrl":null,"twitterHandle":null,"repositoryUrl":"https://github.com/curl","website":"https://curl.se/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://curl.se/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/curl"}],"location":null,"tags":["c","client","curl","ftp","http","https","ldap","libcurl","library","transfer-data","user-agent","open source","hacktoberfest"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Wed Apr 04 2018 12:00:43 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{"key":38907,"type":"yearlyBudget","title":"server cost","amount":260000,"description":"This amount is half the actual server cost as it is not used for curl services alone. We estimate curl and related matters to be roughly half the traffic and \"issues\" on the machine."},{"key":25671,"type":"yearlyBudget","title":"curl up","amount":460000,"description":"Annual developers conference. Needs a room, food, tshirts and other arrangements in a city that people can reach without too much trouble. If possible, we should consider sponsoring attendees who can't otherwise afford it."},{"key":77452,"type":"yearlyBudget","title":"bug bounty program","amount":760000,"description":"By funding this program we can pay security researchers for finding security problems in curl and libcurl."}],"editor":"html","features":{"conversations":true},"githubRepo":"curl/curl","moderation":{"rejectedCategories":[]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":false,"restrictedTo":null},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"events","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"projects","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"useNewSections":true,"legacySectionsBackup":[{"section":"goals","isEnabled":false},{"section":"contribute","isEnabled":true},{"section":"updates","isEnabled":false,"restrictedTo":[]},{"section":"conversations","isEnabled":true},{"section":"budget","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"recurring-contributions","isEnabled":true},{"section":"about","isEnabled":true}]},"crowdfundingRedesign":{"profile":{"name":"curl","cover":{"url":null,"type":"IMAGE"},"description":"client-side internet transfers","longDescription":"\u003cdiv\u003eA command line tool and library for transferring data with URL syntax.\u003cbr /\u003e\u003cbr /\u003ePlease note that sponsorships and donations are exactly that: donations to the curl project. They are used to help and further the project as the project leadership deems best. Not a purchase of any specific service or offer in return.\u003cbr /\u003e\u003cbr /\u003eWe love your sponsorship!\u003c/div\u003e"}},"disablePublicExpenseSubmission":false},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":10,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://opencollective-production.s3.us-west-1.amazonaws.com/1f9a5fe0-9eff-11e8-b5d1-13fa9cd3c0c0.png","imageUrl({\"height\":256})":"https://images.opencollective.com/curl/2b984f3/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["INVOICE","RECEIPT"],"features":{"__ref":"CollectiveFeatures:re0adkjr-v8xwm697-7akq7z5n-4l93bgoy"},"memberOf({\"limit\":1,\"onlyActiveCollectives\":true})":[],"stats":{"__ref":"CollectiveStatsType:14622"},"memberOf({\"limit\":1,\"role\":\"CONNECTED_COLLECTIVE\"})":[],"parentCollective":null,"host":{"__ref":"Organization:11004"},"contributors({\"roles\":[\"ADMIN\",\"MEMBER\"]})":[{"__ref":"Contributor:14617"},{"__ref":"Contributor:28396"},{"__ref":"Contributor:28397"}],"contributors({\"limit\":150,\"roles\":[\"BACKER\"]})":[{"__ref":"Contributor:164160"},{"__ref":"Contributor:69553"},{"__ref":"Contributor:108344"},{"__ref":"Contributor:71987"},{"__ref":"Contributor:16284"},{"__ref":"Contributor:532211"},{"__ref":"Contributor:84664"},{"__ref":"Contributor:4087"},{"__ref":"Contributor:565967"},{"__ref":"Contributor:28100"},{"__ref":"Contributor:7410"},{"__ref":"Contributor:59067"},{"__ref":"Contributor:71557"},{"__ref":"Contributor:70419"},{"__ref":"Contributor:47747"},{"__ref":"Contributor:281703"},{"__ref":"Contributor:301577"},{"__ref":"Contributor:200589"},{"__ref":"Contributor:456282"},{"__ref":"Contributor:12671"},{"__ref":"Contributor:79486"},{"__ref":"Contributor:27550"},{"__ref":"Contributor:108345"},{"__ref":"Contributor:271059"},{"__ref":"Contributor:446436"},{"__ref":"Contributor:508785"},{"__ref":"Contributor:79841"},{"__ref":"Contributor:525308"},{"__ref":"Contributor:7083"},{"__ref":"Contributor:476832"},{"__ref":"Contributor:88879"},{"__ref":"Contributor:51190"},{"__ref":"Contributor:463563"},{"__ref":"Contributor:461110"},{"__ref":"Contributor:35382"},{"__ref":"Contributor:641882"},{"__ref":"Contributor:689721"},{"__ref":"Contributor:662344"},{"__ref":"Contributor