g","type","approvedAt","balance","adminCount","adminEmails","lastContributionDate","lastExpenseDate","totalNumberOfContributions"]}},"autoAssignExpenseCategoryPredictions":true},"features":{"__ref":"CollectiveFeatures:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"location":{"__ref":"Location:288932"},"transferwise":{"__ref":"TransferWise:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"supportedPayoutMethods":["ACCOUNT_BALANCE","BANK_ACCOUNT","STRIPE","PAYPAL","OTHER"],"plan":{"__ref":"HostPlan:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"accountingCategories({\"kind\":\"EXPENSE\"})":{"__typename":"AccountingCategoryCollection","nodes":[{"__ref":"AccountingCategory:xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj"},{"__ref":"AccountingCategory:703k0exg-znm8yj64-n9q5wao9-r7b4dlvr"},{"__ref":"AccountingCategory:xggnxdwz-j3le5mpw-nvpy8rvb-ko04a97b"},{"__ref":"AccountingCategory:dlk9mbw7-y48r3zq3-nd60ej5l-avnodgx7"},{"__ref":"AccountingCategory:ynmlo94z-n7x08dpo-03pewga3-vjbrky5m"},{"__ref":"AccountingCategory:78a47byg-9nxozdp8-xb6mjlv0-3rek5w8k"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-ybq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-jmq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-kw6y870m-gkbrvdn8"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-xeqy870m-gkbrvdn8"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-xkpmj9no-8agdbe57"},{"__ref":"AccountingCategory:m5ax8emk-7lnw54q7-axqgyvj0-o93zdrbn"},{"__ref":"AccountingCategory:y7mywxoz-3409rl6k-kb6venbd-j7gk85ag"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-emqmj9no-8agdbe57"},{"__ref":"AccountingCategory:388rzown-xl9e50px-xbpymvbd-gk7j43a9"},{"__ref":"AccountingCategory:388rzown-xl9e50px-n3qymvbd-gk7j43a9"},{"__ref":"AccountingCategory:acat_ISbfB99gPLtNKJDmzGijM"}]},"policies":{"__ref":"Policies:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"}},"Collective:re0adkjr-v8xwm697-7akq7z5n-4l93bgoy":{"__typename":"Collective","id":"re0adkjr-v8xwm697-7akq7z5n-4l93bgoy","name":"curl","slug":"curl","type":"COLLECTIVE","imageUrl":"https://images.opencollective.com/curl/2b984f3/logo.png","isIncognito":false,"settings":{"goals":[{"key":38907,"type":"yearlyBudget","title":"server cost","amount":260000,"description":"This amount is half the actual server cost as it is not used for curl services alone. We estimate curl and related matters to be roughly half the traffic and \"issues\" on the machine."},{"key":25671,"type":"yearlyBudget","title":"curl up","amount":460000,"description":"Annual developers conference. Needs a room, food, tshirts and other arrangements in a city that people can reach without too much trouble. If possible, we should consider sponsoring attendees who can't otherwise afford it."},{"key":77452,"type":"yearlyBudget","title":"bug bounty program","amount":760000,"description":"By funding this program we can pay security researchers for finding security problems in curl and libcurl."}],"editor":"html","features":{"conversations":true},"githubRepo":"curl/curl","moderation":{"rejectedCategories":[]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":false,"restrictedTo":null},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"events","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"projects","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"useNewSections":true,"legacySectionsBackup":[{"section":"goals","isEnabled":false},{"section":"contribute","isEnabled":true},{"section":"updates","isEnabled":false,"restrictedTo":[]},{"section":"conversations","isEnabled":true},{"section":"budget","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"recurring-contributions","isEnabled":true},{"section":"about","isEnabled":true}]},"crowdfundingRedesign":{"profile":{"name":"curl","cover":{"url":null,"type":"IMAGE"},"description":"client-side internet transfers","longDescription":"\u003cdiv\u003eA command line tool and library for transferring data with URL syntax.\u003cbr /\u003e\u003cbr /\u003ePlease note that sponsorships and donations are exactly that: donations to the curl project. They are used to help and further the project as the project leadership deems best. Not a purchase of any specific service or offer in return.\u003cbr /\u003e\u003cbr /\u003eWe love your sponsorship!\u003c/div\u003e"}},"disablePublicExpenseSubmission":false},"host":{"__ref":"Host:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"hostFeePercent":10,"publicId":"acc_QgF7hFF3v7I0TkrRh4aJX","legalName":null,"description":"client-side internet transfers","isHost":false,"isArchived":false,"isVerified":false,"hasPublicProfile":true,"approvedAt":"2018-04-04T12:00:43.516Z","createdAt":"2018-04-04T12:00:43.468Z","currency":"USD","stats":{"__ref":"AccountStats:re0adkjr-v8xwm697-7akq7z5n-4l93bgoy"}},"Organization:mvrwng4k-j03dpbm0-zk9qz57o-yl9e8xba":{"__typename":"Organization","id":"mvrwng4k-j03dpbm0-zk9qz57o-yl9e8xba","name":"Thebestsolution","slug":"thebestsolution","type":"ORGANIZATI