"Collective:k3z8arxv-eymko60y-73wqgl5n-bj9w704d":{"__typename":"Collective","id":"k3z8arxv-eymko60y-73wqgl5n-bj9w704d","currency":"USD","stats":{"__ref":"AccountStats:k3z8arxv-eymko60y-73wqgl5n-bj9w704d"},"updates({\"limit\":3,\"onlyPublishedUpdates\":true})":{"__typename":"UpdateCollection","nodes":[{"__ref":"Update:dgm9bnk8-0437xqrn-0wk6vzeo-ljdayw5r"},{"__ref":"Update:8a47byg9-nxozdp8y-8d9qmjlv-03rek5w8"},{"__ref":"Update:dgm9bnk8-0437xqry-855pvzeo-ljdayw5r"}]}},"Individual:x8k03rey-d5agmq50-08eplbwo-z7j4nxv9":{"__typename":"Individual","id":"x8k03rey-d5agmq50-08eplbwo-z7j4nxv9","type":"INDIVIDUAL","name":"Nicholas C. Zakas","slug":"nzakas","imageUrl":"https://images.opencollective.com/nzakas/84e180e/avatar.png"},"Update:dgm9bnk8-0437xqrn-0wk6vzeo-ljdayw5r":{"__typename":"Update","id":"dgm9bnk8-0437xqrn-0wk6vzeo-ljdayw5r","slug":"eslints-2025-year-in-review","title":"ESLint's 2025 year in review","summary":"Hi everyone, 2025 was a great year for ESLint with a lot to show for our work. Please take a moment to review my blog post where I talk about everything that happened on the project:...","createdAt":"2026-02-05T00:12:23.451Z","publishedAt":"2026-02-05T00:12:25.749Z","isPrivate":false,"userCanSeeUpdate":true,"fromAccount":{"__ref":"Individual:x8k03rey-d5agmq50-08eplbwo-z7j4nxv9"}},"Update:8a47byg9-nxozdp8y-8d9qmjlv-03rek5w8":{"__typename":"Update","id":"8a47byg9-nxozdp8y-8d9qmjlv-03rek5w8","slug":"eslints-2024-year-in-review","title":"ESLint's 2024 Year in Review","summary":"After taking a look at 2024, we've put together our year in review. Some of the highlights: 🚀Launched v9.0.0 with new config system.🔌Created language-specific plugins for JSON, Markdown, and CSS.🔍Launched Code Explorer.💸Ran at a nearly...","createdAt":"2025-01-22T18:00:00.907Z","publishedAt":"2025-01-22T18:00:16.534Z","isPrivate":false,"userCanSeeUpdate":true,"fromAccount":{"__ref":"Individual:x8k03rey-d5agmq50-08eplbwo-z7j4nxv9"}},"Update:dgm9bnk8-0437xqry-855pvzeo-ljdayw5r":{"__typename":"Update","id":"dgm9bnk8-0437xqry-855pvzeo-ljdayw5r","slug":"eslint-now-support-linting-of-json-and-markdown","title":"ESLint now support linting of JSON and Markdown","summary":"Today we \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Feslint.org%2Fblog%2F2024%2F10%2Feslint-json-markdown-support%2F\"\u003eannounced\u003c/a\u003e official support for linting JSON and Markdown in ESLint. A lot of the changes we made in...","createdAt":"2024-10-03T21:19:17.544Z","publishedAt":"2024-10-03T21:20:36.125Z","isPrivate":false,"userCanSeeUpdate":true,"fromAccount":{"__ref":"Individual:x8k03rey-d5agmq50-08eplbwo-z7j4nxv9"}}},"__APOLLO_VARIABLES__":{"slug":"eslint","nbContributorsPerContributeCard":4},"__APOLLO_ERROR__":null,"__APOLLO_QUERY_DATA__":{"Collective":{"__typename":"Collective","id":26331,"idV2":"k3z8arxv-eymko60y-73wqgl5n-bj9w704d","slug":"eslint","path":"/eslint","name":"ESLint","hasHosting":false,"description":"The pluggable linting utility for JavaScript and JSX","longDescription":"\u003cdiv\u003eESLint is an open source project that helps developers find and fix problems with their JavaScript code. It's the number one JavaScript linter by downloads on npm (over 6.5 million downloads per week) and is used at companies like Microsoft, Airbnb, Netflix, and Facebook. Due to ESLint's flexibility, it's also able to help find and fix problems in JavaScript derivative languages such as Flow and TypeScript, as well as for mobile development with React Native.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThis collective supports the team that is developing ESLint. The funds collected are intended to support dedicated staff, compensate those who are regularly contributing to ESLint, and hire freelancers to help with needs we can't otherwise meet. Funding also allows us to send team members to conferences, companies, and meetups to meet with our users to discuss and solve the problems they are facing.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eNote:\u003c/strong\u003e We do not accept donations from gambling sites, paper writing services, political groups, hate groups, adult entertainment sites, or any other organization who we don't believe is contributing for the good of the project. We don't offer advertising and we don't give refunds. We are an open source project looking for financial support from our users. \u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003e\u003cem\u003eThis Collective is run by and for the benefit of the independent contributors to the ESLint open source software project. This Collective is not endorsed or administered by OpenJS Foundation, Inc. (the “OpenJS Foundation”), the OpenJS Foundation does not receive and has no control over any funds contributed, the OpenJS Foundation does not direct or otherwise supervise the actions of any contributor to the ESLint project, and all donations made will be expended for the private benefit of or otherwise to reimburse individuals that do not have an employer/employee, contractor, or other agency relationship with the OpenJS Foundation. The ESLint marks used herein are used under license from the OpenJS Foundation for the benefit of the open source software community.\u003cbr /\u003e\u003c/em\u003e\u003cbr /\u003e\u003c/div\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/260d3920-13c4-11ea-9ede-830c6aa7a683.png","backgroundImageUrl":"https://images.opencollective.com/eslint/74e8d66/background.png","twitterHandle":"geteslint","repositoryUrl":"https://github.com/eslint","website":"https://eslint.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://eslint.org/"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/geteslint"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/eslint"},{"__typename":"SocialLink","type":"BLUESKY","url":"https://bsky.app/profile/eslint.org"}],"location":{"__typename":"LocationType","id":"60856","country":"US"},"tags":["open source","linter","javascript","ecmascript"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Thu Dec 13 2018 18:57:29 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{"key":38582,"type":"yearlyBudget","title":"Amount to sustain ESLint for the foreseeable future","amount":24000000}],"editor":"html","githubOrg":"eslint","moderation":{"rejectedCategories":["ADULT","CASINO_GAMBLING","FINANCE_INSURANCE","WRITER","PHARMACY","SEO_AUDIENCE","AFFILIATE_REVIEW"]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","isEnabled":true},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":true},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true}]},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true}]},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]}]},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true},{"name":"conversations","type":"SECTION","isEnabled":true}]},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true},{"name":"our-team","type":"SECTION","isEnabled":true}]}],"showGoals":false,"background":{"crop":{"x":961,"y":-114.66666666666666},"zoom":1},"primaryColor":"#463fd4"},"disablePublicExpenseSubmission":false},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":10,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://opencollective-production.s3.us-west-1.amazonaws.com/ee2b7c20-2e1c-11e9-ae91-21dd05804778.png","imageUrl":"https://images.opencollective.com/eslint/48a2e5d/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["INVOICE","RECEIPT"],"features":{"__typename":"CollectiveFeatures","id":"k3z8arxv-eymko60y-73wqgl5n-bj9w704d","ABOUT":"ACTIVE","CONNECTED_ACCOUNTS":"AVAILABLE","RECEIVE_FINANCIAL_CONTRIBUTIONS":"ACTIVE","RECURRING_CONTRIBUTIONS":"ACTIVE","EVENTS":"AVAILABLE","PROJECTS":"AVAILABLE","USE_EXPENSES":"ACTIVE","RECEIVE_EXPENSES":"ACTIVE","FUNDS_GRANTS_MANAGEMENT":"DISABLED","COLLECTIVE_GOALS":"DISABLED","TOP_FINANCIAL_CONTRIBUTORS":"ACTIVE","CONVERSATIONS":"AVAILABLE","UPDATES":"ACTIVE","TEAM":"ACTIVE","CONTACT_FORM":"ACTIVE","RECEIVE_HOST_APPLICATIONS":"UNSUPPORTED","HOST_DASHBOARD":"UNSUPPORTED","TRANSACTIONS":"ACTIVE","PUBLIC_PROFILE":"ACTIVE"},"memberOf":[{"__typename":"Member","id":194451}],"stats":{"__typename":"CollectiveStatsType","id":26331,"balance":11195248,"yearlyBudget":14019659,"backers":{"__typename":"BackersStatsType","id":26331,"all":544,"users":369,"organizations":149}},"connectedTo":[],"parentCollective":null,"host":{"__typename":"Organization","id":11004,"name":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","hasHosting":true,"location":{"__typename":"LocationType","id":"288932","country":"US"},"settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/for-donors-companies-organizations-and-individuals/refund-requests#refund-requests","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eVirtual cards are debit card numbers issued to OSC's hosted collectives for paying online expenses like recurring vendor payments, online resources or tools, and subscriptions. They are tied directly to a collective's budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eHOW IT WORKS\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/month)\u003c/strong\u003e. We will review your request and reply with any questions.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, the project must have a budget on their Open Collective account that exceeds the corresponding amount and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eELIGIBILITY\u003c/strong\u003e\u003cbr\u003eOSC reviews each virtual card request individually. When determining eligibility, we consider:\u003c/div\u003e\u003cul\u003e\u003cli\u003eHow long the project has been hosted by OSC\u003c/li\u003e\u003cli\u003eWhether the project is in good standing with OSC\u003c/li\u003e\u003cli\u003eThe requesting admin’s history with OSC\u003c/li\u003e\u003cli\u003eThe project’s available balance and transaction history\u003c/li\u003e\u003cli\u003eThe project's typical incoming contributions and outgoing expenses\u003c/li\u003e\u003cli\u003eThe anticipated monthly spending amount\u003c/li\u003e\u003cli\u003eThe proposed use of the card\u003cbr\u003e\u003cbr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eREQUIREMENTS/POLICY\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e\u003c/li\u003e\u003cli\u003eIf a card has not been used for more than 15 months, the card will be frozen\u003c/li\u003e\u003cli\u003eAdmins requesting a card must have their legal name and address on file on their individual Open Collective user profile (not the collective's profile). Only the display name is public; legal name and address are visible only to OSC as fiscal host.\u003c/li\u003e\u003cli\u003eIf no receipt has been uploaded to an expense after 30 days, the card will be frozen\u003c/li\u003e\u003cli\u003e​Admins are personally liable for misuse\u0026nbsp;\u003c/li\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eREQUESTING A CARD\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eOnly project admin's can request a card. \u003cstrong\u003e\u0026nbsp;\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eLog in to the Open Collective platform. In the left navigation, click on Virtual Cards -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eCARDHOLDER CONTACT DETAILS:\u003c/strong\u003e\u003cbr\u003eIf you need to input Cardholder contact details/address:\u003c/div\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eAFTER A PURCHASE IS MADE\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are withdrawn from your initiative immediately.\u003c/li\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt\u0026nbsp;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eIf the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":true,"autopauseUnusedCards":{"period":455,"enabled":true}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"restrictedTo":[]},{"section":"budget","isEnabled":true,"restrictedTo":[]}]},"hostCollective":{"id":11004},"paymentMethods":{"manual":{"title":"Bank Transfer (manual)","legacy":true,"features":{"recurring":false},"instructions":"Note: the instructions for transfers differ depending on whether you're sending from a US or non-US bank.\n\nMake sure to include the reference number, Invoice #, or project receiving the funds in the memo field.\n\nIf you have any questions or need an Invoice, please get in touch with us at hello@oscollective.org\n\n-------------------------------------\n\nFor US transfers (ACH or Wire)\n\nAmount: {amount}\nReference: {reference}\n\nAccount Number: 202525828483\nABA / Routing: 091311229\nSWIFT: CHFGUS44021\n\nAccount type: Business Checking\nBank name: Choice Financial Group\nBank address: 4501 23rd Avenue S, Fargo, ND 58104, USA\n\nAccount name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nInternational Bank Transfers (Wire)\nFor non-U.S. banks\n\nAmount: {amount}\nReference: {reference}\n\nRouting / Wire Number: 123205054\nSWIFT / BIC: UMPQUS6P\n\nAccount type: Business Checking\nBank Name: Columbia Bank\nBank Address: 450 Sansome St., Suite 120, San Francisco, CA 94111, United States\n\nAccount Name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nPlease note that it will take 3~5 business days to process your payment. If you don't see your contribution within a week, please contact us at hello@oscollective.org. \n\nNOTE: WE DO NOT ACCEPT CHECKS"}},"payoutsTwoFactorAuth":{"enabled":true,"rollingLimit":1000000},"newPlatformTipsLedger":true,"forceNewPaypalPayments":true,"disableCryptoContributions":false,"exportedTransactionsFieldSets":{"yptc":{"name":"YPTC","fields":["effectiveDate","legacyId","description","type","kind","group","netAmount","currency","isRefund","isRefunded","refundLegacyId","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","orderMemo","expenseType","payoutMethodType","accountingCategoryCode","accountingCategoryName","merchantId","paymentProcessorFee","taxAmount","shortId","shortGroup","shortRefundId","displayAmount","amount","balance"],"useFieldNames":false,"flattenTaxesAndPaymentProcessorFees":true},"a-team":{"name":"A Team","fields":["datetime","shortId","shortGroup","description","type","kind","isRefund","isRefunded","shortRefundId","displayAmount","amount","paymentProcessorFee","netAmount","balance","currency","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","expenseType","expenseTags","payoutMethodType","merchantId","orderMemo","taxAmount","refundLegacyId","accountingCategoryName","accountingCategoryCode","effectiveDate","legacyId","group","debitAndCreditAmounts"],"flattenTaxesAndPaymentProcessorFees":true},"yptc-id-to-group":{"name":"YPTC - ID to Group","fields":["datetime","shortId","shortGroup"],"useFieldNames":false,"flattenTaxesAndPaymentProcessorFees":false},"yptc-new-export-draft":{"name":"YPTC - New Export Draft","fields":["effectiveDate","description","type","kind","merchantId","amount","netAmount","paymentProcessorFee","paymentMethodType","paymentMethodService","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","orderMemo","expenseType","accountingCategoryCode","accountingCategoryName","orderLegacyId","expenseLegacyId","isReverse","displayAmount","currency","isReversed","reverseKind","datetime","importSourceName","importSourceId","importSourceDescription","importSourceData","accountType","parentAccountSlug","oppositeParentAccountSlug"],"useFieldNames":true,"flattenTaxesAndPaymentProcessorFees":true}},"disablePublicExpenseS