ntributors":{"__ref":"ContributorsStats:7963"}},"Tier:{\"id\":7963}":{"__typename":"Tier","id":7963,"name":"Gold Sponsor","slug":"gold-sponsor","description":"Become a gold sponsor with a monthly donation of $1000 and get your Open Collective avatar image (large) on our README on GitHub and in the hero area on the front page of eslint.org. We will also tweet a thank you from our Twitter account (over 38,000 followers).","useStandalonePage":false,"goal":800000,"interval":"month","currency":"USD","amount":100000,"minimumAmount":100000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:7963"},"contributors({\"limit\":4})":[{"__ref":"Contributor:16411"},{"__ref":"Contributor:9337"},{"__ref":"Contributor:3591"},{"__ref":"Contributor:38231"}]},"ContributorsStats:13163":{"__typename":"ContributorsStats","id":"13163","all":3,"users":0,"organizations":1},"TierStatsType:13163":{"__typename":"TierStatsType","id":13163,"availableQuantity":2147483647,"totalDonated":27688460,"totalRecurringDonations":200000,"contributors":{"__ref":"ContributorsStats:13163"}},"Tier:{\"id\":13163}":{"__typename":"Tier","id":13163,"name":"Platinum Sponsor","slug":"platinum-sponsor","description":"Become a platinum sponsor with a monthly donation of $2000 and get your Open Collective avatar image (large) on our README on GitHub and in the hero area on the front page of eslint.org. We will also tweet a thank you from our Twitter account (over 38,000 followers). ","useStandalonePage":false,"goal":800000,"interval":"month","currency":"USD","amount":200000,"minimumAmount":200000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:13163"},"contributors({\"limit\":4})":[{"__ref":"Contributor:176343"},{"__ref":"Contributor:4087"},{"__ref":"Contributor:278077"}]},"ContributorsStats:79801":{"__typename":"ContributorsStats","id":"79801","all":1,"users":0,"organizations":1},"TierStatsType:79801":{"__typename":"TierStatsType","id":79801,"availableQuantity":2147483647,"totalDonated":2000000,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:79801"}},"Tier:{\"id\":79801}":{"__typename":"Tier","id":79801,"name":"Diamond Sponsor","slug":"diamond-sponsor","description":"Become a diamond sponsor with a monthly donation of $5000 and get your Open Collective avatar image (large) on our README on GitHub and in the hero area on the front page of eslint.org. We will also tweet a thank you from our Twitter account (over 38,000 followers). ","useStandalonePage":false,"goal":1000000,"interval":"month","currency":"USD","amount":500000,"minimumAmount":500000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:79801"},"contributors({\"limit\":4})":[{"__ref":"Contributor:5422"}]},"Member:31612":{"__typename":"Member","id":31612},"Member:369759":{"__typename":"Member","id":369759},"Member:544297":{"__typename":"Member","id":544297},"PlanType:26331":{"__typename":"PlanType","id":26331,"hostedCollectives":0},"Collective:26331":{"__typename":"Collective","id":26331,"idV2":"k3z8arxv-eymko60y-73wqgl5n-bj9w704d","slug":"eslint","path":"/eslint","name":"ESLint","hasHosting":false,"description":"The pluggable linting utility for JavaScript and JSX","longDescription":"\u003cdiv\u003eESLint is an open source project that helps developers find and fix problems with their JavaScript code. It's the number one JavaScript linter by downloads on npm (over 6.5 million downloads per week) and is used at companies like Microsoft, Airbnb, Netflix, and Facebook. Due to ESLint's flexibility, it's also able to help find and fix problems in JavaScript derivative languages such as Flow and TypeScript, as well as for mobile development with React Native.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThis collective supports the team that is developing ESLint. The funds collected are intended to support dedicated staff, compensate those who are regularly contributing to ESLint, and hire freelancers to help with needs we can't otherwise meet. Funding also allows us to send team members to conferences, companies, and meetups to meet with our users to discuss and solve the problems they are facing.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eNote:\u003c/strong\u003e We do not accept donations from gambling sites, paper writing services, political groups, hate groups, adult entertainment sites, or any other organization who we don't believe is contributing for the good of the project. We don't offer advertising and we don't give refunds. We are an open source project looking for financial support from our users. \u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003e\u003cem\u003eThis Collective is run by and for the benefit of the independent contributors to the ESLint open source software project. This Collective is not endorsed or administered by OpenJS Foundation, Inc. (the “OpenJS Foundation”), the OpenJS Foundation does not receive and has no control over any funds contributed, the OpenJS Foundation does not direct or otherwise supervise the actions of any contributor to the ESLint project, and all donations made will be expended for the private benefit of or otherwise to reimburse individuals that do not have an employer/employee, contractor, or other agency relationship with the OpenJS Foundation. The ESLint marks used herein are used under license from the OpenJS Foundation for the benefit of the open source software community.\u003cbr /\u003e\u003c/em\u003e\u003cbr /\u003e\u003c/div\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/260d3920-13c4-11ea-9ede-830c6aa7a683.png","backgroundImageUrl":"https://images.opencollective.com/eslint/74e8d66/background.png","twitterHandle":"geteslint","repositoryUrl":"https://github.com/eslint","website":"https://eslint.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://eslint.org/"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/geteslint"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/eslint"},{"__typename":"SocialLink","type":"BLUESKY","url":"https://bsky.app/profile/eslint.org"}],"location":{"__ref":"LocationType:60856"},"tags":["open source","linter","javascript","ecmascript"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Thu Dec 13 2018 18:57:29 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{"key":38582,"type":"yearlyBudget","title":"Amount to sustain ESLint for the foreseeable future","amount":24000000}],"editor":"html","githubOrg":"eslint","moderation":{"rejectedCategories":["ADULT","CASINO_GAMBLING","FINANCE_INSURANCE","WRITER","PHARMACY","SEO_AUDIENCE","AFFILIATE_REVIEW"]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","isEnabled":true},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":true},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true}]},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true}]},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]}]},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true},{"name":"conversations","type":"SECTION","isEnabled":true}]},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true},{"name":"our-team","type":"SECTION","isEnabled":true}]}],"showGoals":false,"background":{"crop":{"x":961,"y":-114.66