typename":"Tier","id":79801,"name":"Diamond Sponsor","slug":"diamond-sponsor","description":"Become a diamond sponsor with a monthly donation of $5000 and get your Open Collective avatar image (large) on our README on GitHub and in the hero area on the front page of eslint.org. We will also tweet a thank you from our Twitter account (over 38,000 followers). ","useStandalonePage":false,"goal":1000000,"interval":"month","currency":"USD","amount":500000,"minimumAmount":500000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__typename":"TierStatsType","id":79801,"availableQuantity":2147483647,"totalDonated":2000000,"totalRecurringDonations":0,"contributors":{"__typename":"ContributorsStats","id":"79801","all":1,"users":0,"organizations":1}},"contributors":[{"__typename":"Contributor","id":"5422","image":"https://images.opencollective.com/ag-grid/bec0580/logo/64.png","collectiveSlug":"ag-grid","name":"AG Grid","type":"ORGANIZATION","isGuest":false,"hasPublicProfile":true}]}],"events":[],"projects":[],"admins":[{"__typename":"Member","id":31612},{"__typename":"Member","id":369759},{"__typename":"Member","id":544297}],"connectedCollectives":[],"plan":{"__typename":"PlanType","id":26331,"hostedCollectives":0}}}},"scripts":{},"locale":"en","__N_SSP":true,"__APOLLO_STATE__":{"LocationType:60856":{"__typename":"LocationType","id":"60856","country":"US"},"CollectiveFeatures:k3z8arxv-eymko60y-73wqgl5n-bj9w704d":{"__typename":"CollectiveFeatures","id":"k3z8arxv-eymko60y-73wqgl5n-bj9w704d","ABOUT":"ACTIVE","CONNECTED_ACCOUNTS":"AVAILABLE","RECEIVE_FINANCIAL_CONTRIBUTIONS":"ACTIVE","RECURRING_CONTRIBUTIONS":"ACTIVE","EVENTS":"AVAILABLE","PROJECTS":"AVAILABLE","USE_EXPENSES":"ACTIVE","RECEIVE_EXPENSES":"ACTIVE","FUNDS_GRANTS_MANAGEMENT":"DISABLED","COLLECTIVE_GOALS":"DISABLED","TOP_FINANCIAL_CONTRIBUTORS":"ACTIVE","CONVERSATIONS":"AVAILABLE","UPDATES":"ACTIVE","TEAM":"ACTIVE","CONTACT_FORM":"ACTIVE","RECEIVE_HOST_APPLICATIONS":"UNSUPPORTED","HOST_DASHBOARD":"UNSUPPORTED","TRANSACTIONS":"ACTIVE","PUBLIC_PROFILE":"ACTIVE"},"Member:194451":{"__typename":"Member","id":194451},"BackersStatsType:26331":{"__typename":"BackersStatsType","id":26331,"all":544,"users":369,"organizations":149},"CollectiveStatsType:26331":{"__typename":"CollectiveStatsType","id":26331,"balance":11195248,"yearlyBudget":14019659,"backers":{"__ref":"BackersStatsType:26331"}},"LocationType:288932":{"__typename":"LocationType","id":"288932","country":"US"},"PlanType:11004":{"__typename":"PlanType","id":11004,"hostFees":true,"hostFeeSharePercent":0},"Policies:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"Policies","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k","COLLECTIVE_MINIMUM_ADMINS":{"__typename":"COLLECTIVE_MINIMUM_ADMINS","freeze":false,"numberOfAdmins":0}},"Organization:11004":{"__typename":"Organization","id":11004,"name":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","hasHosting":true,"location":{"__ref":"LocationType:288932"},"settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/for-donors-companies-organizations-and-individuals/refund-requests#refund-requests","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eVirtual cards are debit card numbers issued to OSC's hosted collectives for paying online expenses like recurring vendor payments, online resources or tools, and subscriptions. They are tied directly to a collective's budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eHOW IT WORKS\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/month)\u003c/strong\u003e. We will review your request and reply with any questions.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, the project must have a budget on their Open Collective account that exceeds the corresponding amount and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eELIGIBILITY\u003c/strong\u003e\u003cbr\u003eOSC reviews each virtual card request individually. When determining eligibility, we consider:\u003c/div\u003e\u003cul\u003e\u003cli\u003eHow long the project has been hosted by OSC\u003c/li\u003e\u003cli\u003eWhether the project is in good standing with OSC\u003c/li\u003e\u003cli\u003eThe requesting admin’s history with OSC\u003c/li\u003e\u003cli\u003eThe project’s available balance and transaction history\u003c/li\u003e\u003cli\u003eThe project's typical incoming contributions and outgoing expenses\u003c/li\u003e\u003cli\u003eThe anticipated monthly spending amount\u003c/li\u003e\u003cli\u003eThe proposed use of the card\u003cbr\u003e\u003cbr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eREQUIREMENTS/POLICY\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e\u003c/li\u003e\u003cli\u003eIf a card has not been used for more than 15 months, the card will be frozen\u003c/li\u003e\u003cli\u003eAdmins requesting a card must have their legal name and address on file on their individual Open Collective user profile (not the collective's profile). Only the display name is public; legal name and address are visible only to OSC as fiscal host.\u003c/li\u003e\u003cli\u003eIf no receipt has been uploaded to an expense after 30 days, the card will be frozen\u003c/li\u003e\u003cli\u003e​Admins are personally liable for misuse\u0026nbsp;\u003c/li\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eREQUESTING A CARD\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eOnly project admin's can request a card. \u003cstrong\u003e\u0026nbsp;\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eLog in to the Open Collective platform. In the left navigation, click on Virtual Cards -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eCARDHOLDER CONTACT DETAILS:\u003c/strong\u003e\u003cbr\u003eIf you need to input Cardholder contact details/address:\u003c/div\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eAFTER A PURCHASE IS MADE\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are withdrawn from your initiative immediately.\u003c/li\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt\u0026nbsp;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eIf the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":true,"autopauseUnusedCards":{"period":455,"enabled":true}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"restrictedTo":[]},{"section":"budget","isEnabled":true,"restrictedTo":[]}]},"hostCollective":{"id":11004},"paymentMethods":{"manual":{"title":"Bank Transfer (manual)","legacy":true,"features":{"recurring":false},"instructions":"Note: the instructions for transfers differ depending on whether you're sending from a