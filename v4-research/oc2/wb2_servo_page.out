weight, high-performance alternative for embedding web technologies\u003c/strong\u003e in applications. Servo is a web browser rendering engine written in Rust, with WebGL and WebGPU support, and adaptable to desktop, mobile, and embedded applications.\u003cbr /\u003e\u003cbr /\u003eCreated by Mozilla Research in 2012, the Servo project began as a research and development effort. Stewardship of Servo moved from Mozilla Research to the \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.linuxfoundation.org%2F\"\u003e\u003cstrong\u003eLinux Foundation\u003c/strong\u003e\u003c/a\u003e in 2020. The project finally moved to \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Flinuxfoundation.eu%2F\"\u003e\u003cstrong\u003eLinux Foundation Europe\u003c/strong\u003e\u003c/a\u003e in 2023 with the mission of trying to regain interest from the broader industry.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eServo is written in \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.rust-lang.org%2F\"\u003e\u003cstrong\u003eRust\u003c/strong\u003e\u003c/a\u003e, taking advantage of the memory safety properties and concurrency features of the language.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eServo is an \u003cstrong\u003eindependent\u003c/strong\u003e project hosted at Linux Foundation Europe and managed openly by the \u003ca href=\"https://github.com/servo/project/blob/main/governance/README.md\"\u003eTechnical Steering Committee\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThe current short-term focus of the project is to \u003cstrong\u003etransition Servo from a research project to a production-ready web engine\u003c/strong\u003e by delivering stable APIs, improving user interaction capabilities, and fostering an active community that contributes to its growth.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThe project’s long-term vision is to make Servo the \u003cstrong\u003eleading embeddable web engine\u003c/strong\u003e that powers innovative applications and frameworks, offering unparalleled performance, stability, and modern web standards compliance.\u003cbr /\u003e\u003cbr /\u003eSince its creation in 2012, Servo has contributed to W3C and WHATWG web standards, reporting specification issues and submitting new cross-browser automated tests, and core team members have co-edited new standards that have been adopted by other browsers. As a result, the Servo project \u003cstrong\u003ehelps drive the entire web platform forward\u003c/strong\u003e, while building on a platform of reusable, modular technologies that implement web standards.\u003c/div\u003e\u003cdiv\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThis is a donation. No goods or services are expected in return. Any requests for refunds for those purposes will be rejected.\u003cbr /\u003e\u003cbr /\u003eThe Servo Technical Steering Committee will collectively discuss how to prioritize the spending of available funds in the \u003ca href=\"https://github.com/servo/project/blob/main/governance/tsc/README.md\"\u003epublic monthly calls\u003c/a\u003e. You can check how we're using the money right now in \u003ca href=\"https://github.com/servo/project/issues/187\"\u003ethis issue\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003eFor more details on sponsorship tiers and fees, go to \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fservo.org%2Fsponsorship%2F\"\u003ehttps://servo.org/sponsorship/\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003e\u003cbr /\u003e\u003c/div\u003e","backgroundImage":null,"backgroundImageUrl":null,"twitterHandle":"ServoDev","repositoryUrl":"https://github.com/servo/servo","website":"https://servo.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://servo.org/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/servo/servo"},{"__typename":"SocialLink","type":"MASTODON","url":"https://floss.social/@servo"},{"__typename":"SocialLink","type":"BLUESKY","url":"https://bsky.app/profile/servo.org"},{"__typename":"SocialLink","type":"LINKEDIN","url":"https://www.linkedin.com/company/servo-project/"}],"location":null,"tags":["open source","web engine","rust","open-prioritization"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Tue Feb 13 2024 23:25:14 GMT+0000 (Coordinated Universal Time)","settings":{"features":{"conversations":true},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":true},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true}]},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true}]},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","isEnabled":true}]},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true},{"name":"conversations","type":"SECTION","isEnabled":true}]},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true},{"name":"our-team","type":"SECTION","isEnabled":true}]}],"showGoals":true,"background":{"crop":{"x":0,"y":0},"zoom":1,"mediaSize":{"width":1500,"height":500},"isAlignedRight":true},"primaryColor":"#3062BC"},"crowdfundingRedesign":{"profile":{"name":"Servo","cover":{"url":null,"type":"IMAGE","width":1500,"height":500},"description":"The embeddable, independent, memory-safe, modular, parallel web rendering engine. For more details on fees, go to https://servo.org/sponsorship/#donation-fees","primaryColor":"#3062BC","longDescription":"\u003cdiv\u003e\u003cfigure data-trix-attachment=\"{\u0026quot;content\u0026quot;:\u0026quot;\u003ciframe src=\\\u0026quot;https://www.youtube-nocookie.com/embed/sn9CXPEepvc/?showinfo=0\\\u0026quot; width=\\\u0026quot;100%\\\u0026quot; height=\\\u0026quot;394\\\u0026quot; frameborder=\\\u0026quot;0\\\u0026quot; allowfullscreen=\\\u0026quot;\\\u0026quot;\u003e\u003c/iframe\u003e\u0026quot;,\u0026quot;contentType\u0026quot;:\u0026quot;--embed-iframe-video\u0026quot;}\" data-trix-content-type=\"--embed-iframe-video\" class=\"attachment attachment--content\"\u003e\u003ciframe src=\"https://www.youtube-nocookie.com/embed/sn9CXPEepvc/?showinfo=0\" width=\"100%\" height=\"394\" frameborder=\"0\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003cfigcaption class=\"attachment__caption\"\u003e\u003c/figcaption\u003e\u003c/figure\u003e\u003cbr\u003eServo is an embeddable, independent, memory-safe, modular, parallel web rendering engine written in Rust. It has WebGL and WebGPU support, and is adaptable to desktop, mobile, and embedded applications on many operating systems.\u003cbr\u003e\u003cbr\u003eCreated by Mozilla Research in 2012, the Servo project is a research and development effort. It is written in \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.rust-lang.org%2F\"\u003e\u003cstrong\u003eRust\u003c/strong\u003e\u003c/a\u003e, taking advantage of the memory safety properties and concurrency features of the language. Work on Servo has helped contribute to W3C and WHATWG web standards, reporting specification issues and submitting new cross-browser automated tests, and core team members have co-edited new standards that have been adopted by other browsers. As a novel engine without origins in Gecko or WebKit, the Servo project helps drive the entire web platform forward.\u0026nbsp; \u0026nbsp;\u003cbr\u003e\u003cbr\u003e In 2020, Mozilla Research handed stewardship over to the \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.linuxfoundation.org%2F\"\u003e\u003cstrong\u003eLinux Foundation\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e. \u003c/strong\u003e\u0026nbsp;In 2023,\u003cstrong\u003e \u003c/strong\u003ethanks to some external funding and investment of their own, \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fthenewstack.io%2Figalia-the-open-source-powerhouse-youve-never-heard-of%2F\"\u003e\u003cstrong\u003eIgalia\u003c/strong\u003e\u003c/a\u003e got involved and the project moved to \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Flinuxfoundation.eu%2F\"\u003e\u003cstrong\u003eLinux Foundation Europe\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e.\u003cbr\u003e\u003cbr\u003e\u003c/strong\u003eFunds from this collective will be used first to cover infrastructure costs that keep engine releases available, integrated with Web Platform Tests, and so on. Once those needs are met, extra available funds can be applied toward sponsoring more infra costs related to improvements or development.\u003cbr\u003e\u003cbr\u003eThe Servo Technical Steering Committee will collectively discuss how to prioritize the spending of available funds in the \u003ca href=\"https://github.com/servo/project/blob/main/governance/tsc/README.md\"\u003epublic monthly calls\u003c/a\u003e.\u003c/div\u003e"}},"disableCustomContributions":true},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":4,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://opencollective-production.s3.us-west-1.amazonaws.com/account-avatar/bca1bcef-dd71-4fa5-a37d-7058469b663b/cFUrstSq_400x400.jpg","imageUrl":"https://images.opencollective.com/servo/d6723ab/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["INVOICE","RECEIPT"],"features":{"__typename":"CollectiveFeatures","id":"3kzxy4v0-7wlr6mkz-vb7qmj9n-o8agdbe5","ABOUT":"ACTIVE","CONNECTED_ACCOUNTS":"AVAILABLE","RECEIVE_FINANCIAL_CONTRIBUTIONS":"ACTIVE","RECURRING_CONTRIBUTIONS":"AVAILABLE","EVENTS":"AVAILABLE","PROJECTS":"AVAILABLE","USE_EXPENSES":"ACTIVE","RECEIVE_EXPENSES":"ACTIVE","FUNDS_GRANTS_MANAGEMENT":"DISABLED","COLLECTIVE_GOALS":"ACTIVE","TOP_FINANCIAL_CONTRIBUTORS":"ACTIVE","CONVERSATIONS":"AVAILABLE","UPDATES":"ACTIVE","TEAM":"ACTIVE","CONTACT_FORM":"ACTIVE","RECEIVE_HOST_APPLICATIONS":"UNSUPPORTED","HOST_DASHBOARD":"UNSUPPORTED","TRANSACTIONS":"ACTIVE","PUBLIC_PROFILE":"ACTIVE"},"memberOf":[],"stats":{"__typename":"CollectiveStatsType","id":761342,"balance":7592286,"yearlyBudget":8893637,"backers":{"__typename":"BackersStatsType","id":761342,"all":571,"users":555,"organizations":14}},"connectedTo":[],"parentCollective":null,"host":{"__typename":"Organization","id":11004,"name":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","hasHosting":true,"location":{"__typename":"LocationType","id":"288932","country":"US"},"settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/for-donors-companies-organizations-and-individuals/refund-requests#refund-requests","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eVirtual cards are debit card numbers issued to OSC's hosted collectives for paying online expenses like recurring vendor payments, online resources or tools, and subscriptions. They are tied directly to a collective's budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eHOW IT WORKS\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/month)\u003c/strong\u003e. We will review your request and reply with any questions.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, the project must have a budget on their Open Collective account that exceeds the corresponding amount and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eELIGIBILITY\u003c/strong\u003e\u003cbr\u003eOSC reviews each virtual card request individually. When determining eligibility, we consider:\u003c/div\u003e\u003cul\u003e\u003cli\u003eHow long the project has been hosted by OSC\u003c/li\u003e\u003cli\u003eWhether the project is in good standing with OSC\u003c/li\u003e\u003cli\u003eThe requesting admin’s history with OSC\u003c/li\u003e\u003cli\u003eThe project’s available balance and transaction history\u003c/li\u003e\u003cli\u003eThe project's typical incoming contributions and outgoing expenses\u003c/li\u003e\u003cli\u003eThe anticipated monthly spending amount\u003c/li\u003e\u003cli\u003eThe proposed use of the card\u003cbr\u003e\u003cbr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eREQUIREMENTS/POLICY\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e\u003c/li\u003e\u003cli\u003eIf a card has not been used for more than 15 months, the card will be frozen\u003c/li\u003e\u003cli\u003eAdmins requesting a card must have their legal name and address on file on their individual Open Collective user profile (not the collective's profile). Only the display name is public; legal name and address are visible only to OSC as fiscal host.\u003c/li\u003e\u003cli\u003eIf no receipt has been uploaded to an expense after 30 days, the card will be frozen\u003c/li\u003e\u003cli\u003e​Admins are personally liable for misuse\u0026nbsp;\u003c/li\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eREQUESTING A CARD\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eOnly project admin's can request a card. \u003cstrong\u003e\u0026nbsp;\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eLog in to the Open Collective platform. In the left navigation, click on Virtual Cards -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eCARDHOLDER CONTACT DETAILS:\u003c/strong\u003e\u003cbr\u003eIf you need to input Cardholder contact details/address:\u003c/div\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eAFTER A PURCHASE IS MADE\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are withdrawn from your initiative immediately.\u003c/li\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt\u0026nbsp;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eIf the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":true,"autopauseUnusedCards":{"period":455,"enabled":true}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"restrictedTo":[]},{"section":"budget","isEnabled":true,"restrictedTo":[]}]},"hostCollective":{"id":11004},"paymentMethods":{"manual":{"title":"Bank Transfer (manual)","le