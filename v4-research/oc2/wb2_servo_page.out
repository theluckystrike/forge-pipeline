ename":"TierStatsType","id":73141,"availableQuantity":2147483647,"totalDonated":1517000,"totalRecurringDonations":77150,"contributors":{"__ref":"ContributorsStats:73141"}},"Tier:{\"id\":73141}":{"__typename":"Tier","id":73141,"name":"Sustainer","slug":"sustainer","description":"Servo receives $9.01 (Stripe) or $8.62 (PayPal) out of $10, as of 2024-05-10","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":1000,"minimumAmount":null,"button":null,"amountType":"FIXED","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:73141"},"contributors({\"limit\":4})":[{"__ref":"Contributor:129409"},{"__ref":"Contributor:1392"},{"__ref":"Contributor:799692"},{"__ref":"Contributor:801834"}]},"ContributorsStats:71369":{"__typename":"ContributorsStats","id":"71369","all":17,"users":14,"organizations":3},"TierStatsType:71369":{"__typename":"TierStatsType","id":71369,"availableQuantity":2147483647,"totalDonated":1618000,"totalRecurringDonations":152000,"contributors":{"__ref":"ContributorsStats:71369"}},"Tier:{\"id\":71369}":{"__typename":"Tier","id":71369,"name":"sponsor","slug":"sponsor","description":"Servo receives $91.30 (Stripe) or $90.52 (PayPal) out of $100, as of 2024-05-10","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":10000,"minimumAmount":10000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:71369"},"contributors({\"limit\":4})":[{"__ref":"Contributor:848596"},{"__ref":"Contributor:920603"},{"__ref":"Contributor:952727"},{"__ref":"Contributor:461110"}]},"ContributorsStats:73860":{"__typename":"ContributorsStats","id":"73860","all":227,"users":221,"organizations":5},"TierStatsType:73860":{"__typename":"TierStatsType","id":73860,"availableQuantity":2147483647,"totalDonated":2044200,"totalRecurringDonations":37996,"contributors":{"__ref":"ContributorsStats:73860"}},"Tier:{\"id\":73860}":{"__typename":"Tier","id":73860,"name":"Custom (one-time or monthly)","slug":"custom-one-time-or-monthly","description":"Minimum is 5 USD, otherwise fees are too high (for example, 1 USD donation loses up to 0.58 USD in fees)","useStandalonePage":false,"goal":null,"interval":"flexible","currency":"USD","amount":null,"minimumAmount":500,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:73860"},"contributors({\"limit\":4})":[{"__ref":"Contributor:755728"},{"__ref":"Contributor:851582"},{"__ref":"Contributor:1155875"},{"__ref":"Contributor:947661"}]},"Member:535109":{"__typename":"Member","id":535109},"Member:535252":{"__typename":"Member","id":535252},"Member:537769":{"__typename":"Member","id":537769},"Member:798318":{"__typename":"Member","id":798318},"Member:863370":{"__typename":"Member","id":863370},"PlanType:761342":{"__typename":"PlanType","id":761342,"hostedCollectives":0},"Collective:761342":{"__typename":"Collective","id":761342,"idV2":"3kzxy4v0-7wlr6mkz-vb7qmj9n-o8agdbe5","slug":"servo","path":"/servo","name":"Servo","hasHosting":false,"description":"Servo aims to empower developers with a lightweight, high-performance alternative for embedding web technologies in applications. For more details on sponsorship tiers and fees, go to https://servo.org/sponsorship/","longDescription":"\u003cdiv\u003e\u003cfigure data-trix-content-type=\"--embed-iframe-video\"\u003e\u003ciframe src=\"https://www.youtube-nocookie.com/embed/sn9CXPEepvc/?showinfo=0\" width=\"100%\" height=\"394\"\u003e\u003c/iframe\u003e\u003cfigcaption\u003e\u003c/figcaption\u003e\u003c/figure\u003e\u003cbr /\u003eServo aims to empower developers with a \u003cstrong\u003elightweight, high-performance alternative for embedding web technologies\u003c/strong\u003e in applications. Servo is a web browser rendering engine written in Rust, with WebGL and WebGPU support, and adaptable to desktop, mobile, and embedded applications.\u003cbr /\u003e\u003cbr /\u003eCreated by Mozilla Research in 2012, the Servo project began as a research and development effort. Stewardship of Servo moved from Mozilla Research to the \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.linuxfoundation.org%2F\"\u003e\u003cstrong\u003eLinux Foundation\u003c/strong\u003e\u003c/a\u003e in 2020. The project finally moved to \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Flinuxfoundation.eu%2F\"\u003e\u003cstrong\u003eLinux Foundation Europe\u003c/strong\u003e\u003c/a\u003e in 2023 with the mission of trying to regain interest from the broader industry.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eServo is written in \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.rust-lang.org%2F\"\u003e\u003cstrong\u003eRust\u003c/strong\u003e\u003c/a\u003e, taking advantage of the memory safety properties and concurrency features of the language.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eServo is an \u003cstrong\u003eindependent\u003c/strong\u003e project hosted at Linux Foundation Europe and managed openly by the \u003ca href=\"https://github.com/servo/project/blob/main/governance/README.md\"\u003eTechnical Steering Committee\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThe current short-term focus of the project is to \u003cstrong\u003etransition Servo from a research project to a production-ready web engine\u003c/strong\u003e by delivering stable APIs, improving user interaction capabilities, and fostering an active community that contributes to its growth.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThe project’s long-term vision is to make Servo the \u003cstrong\u003eleading embeddable web engine\u003c/strong\u003e that powers innovative applications and frameworks, offering unparalleled performance, stability, and modern web standards compliance.\u003cbr /\u003e\u003cbr /\u003eSince its creation in 2012, Servo has contributed to W3C and WHATWG web standards, reporting specification issues and submitting new cross-browser automated tests, and core team members have co-edited new standards that have been adopted by other browsers. As a result, the Servo project \u003cstrong\u003ehelps drive the entire web platform forward\u003c/strong\u003e, while building on a platform of reusable, modular technologies that implement web standards.\u003c/div\u003e\u003cdiv\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThis is a donation. No goods or services are expected in return. Any requests for refunds for those purposes will be rejected.\u003cbr /\u003e\u003cbr /\u003eThe Servo Technical Steering Committee will collectively discuss how to prioritize the spending of available funds in the \u003ca href=\"https://github.com/servo/project/blob/main/governance/tsc/README.md\"\u003epublic monthly calls\u003c/a\u003e. You can check how we're using the money right now in \u003ca href=\"https://github.com/servo/project/issues/187\"\u003ethis issue\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003eFor more details on sponsorship tiers and fees, go to \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fservo.org%2Fsponsorship%2F\"\u003ehttps://servo.org/sponsorship/\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003e\u003cbr /\u003e\u003c/div\u003e","backgroundImage":null,"backgroundImageUrl":null,"twitterHandle":"ServoDev","repositoryUrl":"https://github.com/servo/servo","website":"https://servo.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://servo.org/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/servo/servo"},{"__typename":"SocialLink","type":"MASTODON","url":"https://floss.social/@servo"},{"__typename":"SocialLink","type":"BLUESKY","url":"https://bsky.app/profile/servo.org"},{"__typename":"SocialLink","type":"LINKEDIN","url":"https://www.linkedin.com/company/servo-project/"}],"location":null,"tags":["open source","web engine","rust","open-prioritization"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Tue Feb 13 2024 23:25:14 GMT+0000 (Coordinated Universal Time)","settings":{"features":{"conversations":true},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":true},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true}]},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true}]},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","isEnabled":true}]},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true},{"name":"conversations","type":"SECTION","isEnabled":true}]},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true},{"name":"our-team","type":"SECTION","isEnabled":true}]}],"showGoals":true,"background":{"crop":{"x":0,"y":0},"zoom":1,"mediaSize":{"width":1500,"height":500},"isAlignedRight":true},"primaryColor":"#3062BC"},"crowdfundingRedesign":{"profile":{"name":"Servo","cover":{"url":null,"type":"IMAGE","width":1500,"height":500},"description":"The embeddable, independent, memory-safe, modular, parallel web rendering engine. For more details on fees, go to https://servo.org/sponsorship/#donation-fees","primaryColor":"#3062BC","longDescription":"\u003cdiv\u003e\u003cfigure data-trix-attachment=\"{\u0026quot;content\u0026quot;:\u0026quot;\u003ciframe src=\\\u0026quot;https://www.youtube-nocookie.com/embed/sn9CXPEepvc/?showinfo=0\\\u0026quot; width=\\\u0026quot;100%\\\u0026quot; height=\\\u0026quot;394\\\u0026quot; frameborder=\\\u0026quot;0\\\u0026quot; allowfullscreen=\\\u0026quot;\\\u0026quot;\u003e\u003c/iframe\u003e\u0026quot;,\u0026quot;contentType\u0026quot;:\u0026quot;--embed-iframe-video\u0026quot;}\" data-trix-content-type=\"--embed-iframe-video\" class=\"attachment attachment--content\"\u003e\u003ciframe src=\"https://www.youtube-nocookie.com/embed/sn9CXPEepvc/?showinfo=0\" width=\"100%\" height=\"394\" frameborder=\"0\" allowfullscreen=\"\"\u003e\u003c/iframe\u003e\u003cfigcaption class=\"attachment__caption\"\u003e\u003c/figcaption\u003e\u003c/figure\u003e\u003cbr\u003eServo is an embeddable, independent, memory-safe, modular, parallel web rendering engine written in Rust. It has WebGL and WebGPU support, and is adaptable to desktop, mobile, and embedded applications on many operating systems.\u003cbr\u003e\u003cbr\u003eCreated by Mozilla Research in 2012, the Servo project is a research and development effort. It is written in \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.rust-lang.org%2F\"\u003e\u003cstrong\u003eRust\u003c/strong\u003e\u003c/a\u003e, taking advantage of the memory safety properties and concurrency features of the language. Work on Servo has helped contribute to W3C and WHATWG web standards, reporting specification issues and submitting new cross-browser automated tests, and core team members have co-edited new standards that have been adopted by other browsers. As a novel engine without origins in Gecko or WebKit, the Servo project helps drive the entire web platform forward.\u0026nbsp; \u0026nbsp;\u003cbr\u003e\u003cbr\u003e In 2020, Mozilla Research handed stewardship over to the \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.linuxfoundation.org%2F\"\u003e\u003cstrong\u003eLinux Foundation\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e. \u003c/strong\u003e\u0026nbsp;In 2023,\u003cstrong\u003e \u003c/strong\u003ethanks to some external funding and investment of their own, \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fthenewstack.io%2Figalia-the-open-source-powerhouse-youve-never-heard-of%2F\"\u003e\u003cstrong\u003eIgalia\u003c/strong\u003e\u003c/a\u003e got involved and the project moved to \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Flinuxfoundation.eu%2F\"\u003e\u003cstrong\u003eLinux Foundation Europe\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e.\u003cbr\u003e\u003cbr\u003e\u003c/strong\u003eFunds from this collective will be used first to cover infrastructure costs that keep engine releases available, integrated with Web Platform Tests, and so on. Once those needs are met, extra available funds can be applied toward sponsoring more infra costs related to improvements or development.\u003cbr\u003e\u003cbr\u003eThe Servo Technical Steering Committee will collectively discuss how to prioritize the spending of available funds in the \u003ca href=\"https://github.com/servo/project/blob/main/governance/tsc/README.md\"\u003epublic monthly calls\u003c/a\u003e.\u003c/div\u003e"}},"disableCustomContributions":true},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":4,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://opencollective-production.s3.us-west-1.amazonaws.com/account-avatar/bca1bcef-dd71-4fa5-a37d-7058469b663b/cFUrstSq_400x400.jpg","imageUrl({\"height\":256})":"https://images.opencollective.com/servo/d6723ab/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["INVOICE","RECEIPT"],"features":{"__ref":"CollectiveFeatures:3kzxy4v0-7wlr6mkz-vb7qmj9n-o8agdbe5"},"memberOf({\"limit\":1,\"onlyActiveCollectives\":true})":[],"stats":{"__ref":"CollectiveStatsType:761342"},"memberOf({\"limit\":1,\