nth","currency":"USD","amount":1000,"minimumAmount":500,"button":"Become a backer","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:965"},"contributors({\"limit\":4})":[{"__ref":"Contributor:16411"},{"__ref":"Contributor:7410"},{"__ref":"Contributor:241486"},{"__ref":"Contributor:44355"}]},"ContributorsStats:966":{"__typename":"ContributorsStats","id":"966","all":14,"users":2,"organizations":12},"TierStatsType:966":{"__typename":"TierStatsType","id":966,"availableQuantity":2147483647,"totalDonated":9750570,"totalRecurringDonations":150000,"contributors":{"__ref":"ContributorsStats:966"}},"Tier:{\"id\":966}":{"__typename":"Tier","id":966,"name":"Sponsors","slug":"sponsors","description":"Is your company using Mocha? Ask your manager to support us!","useStandalonePage":true,"goal":null,"interval":"month","currency":"USD","amount":50000,"minimumAmount":50000,"button":"Become a sponsor","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:966"},"contributors({\"limit\":4})":[{"__ref":"Contributor:13393"},{"__ref":"Contributor:5301"},{"__ref":"Contributor:7410"},{"__ref":"Contributor:52544"}]},"Member:529546":{"__typename":"Member","id":529546},"Member:722139":{"__typename":"Member","id":722139},"PlanType:58":{"__typename":"PlanType","id":58,"hostedCollectives":0},"Collective:58":{"__typename":"Collective","id":58,"idV2":"xrmvrwng-4kj03dpb-9z6z57oy-l9e8xbaj","slug":"mochajs","path":"/mochajs","name":"Mocha","hasHosting":false,"description":"☕️ Classic, reliable, trusted test framework for Node.js and the browser","longDescription":"\u003cdiv\u003eMocha is a feature-rich JavaScript test framework running on Node.js and the browser, making asynchronous testing reliable and fun. Mocha tests run serially or in parallel, allowing for flexible and accurate reporting, while mapping uncaught exceptions to the correct test cases. \u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003ch3\u003eStats\u003c/h3\u003e\u003cul\u003e\u003cli\u003eMocha is downloaded roughly 12M times per week \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.npmjs.com%2Fpackage%2Fmocha\"\u003eon NPM\u003c/a\u003e.\u003c/li\u003e\u003cli\u003eThe repo has more than 20k stars and 30k unique visitors per month.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr /\u003eDisclaimer: This Collective is run by and for the benefit of the independent contributors to the Mocha open source software project. This Collective is not endorsed or administered by the OpenJS Foundation; the OpenJS Foundation does not receive and has no control over any funds contributed; the OpenJS Foundation does not direct or otherwise supervise the actions of any contributor to the Mocha project; and all donations made will be expended for the private benefit of or otherwise to reimburse individuals that do not have an employer/employee, contractor, or other agency relationship with the OpenJS Foundation. The Mocha marks used herein are used under license from the OpenJS Foundation for the benefit of the open source software community.\u003cbr /\u003e\u003cbr /\u003eSponsoring Mocha does not guarantee ad placement on mochajs.org. The Mocha project reserves the right to restrict placement for any reason, including, but not limited to, excluding obvious spam.\u003c/div\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/5d0b1160-20c6-11e8-9fc9-47523ab65bdd.png","backgroundImageUrl":"https://images.opencollective.com/mochajs/607ad9a/background.png","twitterHandle":null,"repositoryUrl":"https://github.com/mochajs/mocha","website":"https://mochajs.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://mochajs.org/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/mochajs/mocha"}],"location":null,"tags":["open source","testing","bdd","test","javascript","node.js","typescript"],"company":null,"type"