InvoiceAmount":1},{"code":"GYD","minInvoiceAmount":1},{"code":"HKD","minInvoiceAmount":1},{"code":"HNL","minInvoiceAmount":1},{"code":"HTG","minInvoiceAmount":1},{"code":"HUF","minInvoiceAmount":1},{"code":"IDR","minInvoiceAmount":3},{"code":"ILS","minInvoiceAmount":1},{"code":"ISK","minInvoiceAmount":1},{"code":"JMD","minInvoiceAmount":1},{"code":"JPY","minInvoiceAmount":1},{"code":"KES","minInvoiceAmount":1},{"code":"KGS","minInvoiceAmount":1},{"code":"KHR","minInvoiceAmount":1},{"code":"KRW","minInvoiceAmount":1},{"code":"KWD","minInvoiceAmount":4},{"code":"KYD","minInvoiceAmount":2},{"code":"LAK","minInvoiceAmount":1},{"code":"LKR","minInvoiceAmount":1},{"code":"LSL","minInvoiceAmount":1},{"code":"MAD","minInvoiceAmount":1},{"code":"MNT","minInvoiceAmount":1},{"code":"MOP","minInvoiceAmount":1},{"code":"MUR","minInvoiceAmount":1},{"code":"MVR","minInvoiceAmount":1},{"code":"MWK","minInvoiceAmount":1},{"code":"MXN","minInvoiceAmount":1},{"code":"MYR","minInvoiceAmount":1},{"code":"MZN","minInvoiceAmount":6},{"code":"NAD","minInvoiceAmount":1},{"code":"NIO","minInvoiceAmount":1},{"code":"NOK","minInvoiceAmount":1},{"code":"NPR","minInvoiceAmount":1},{"code":"NZD","minInvoiceAmount":1},{"code":"OMR","minInvoiceAmount":3},{"code":"PEN","minInvoiceAmount":3},{"code":"PGK","minInvoiceAmount":1},{"code":"PHP","minInvoiceAmount":1},{"code":"PKR","minInvoiceAmount":1},{"code":"PLN","minInvoiceAmount":1},{"code":"PYG","minInvoiceAmount":1},{"code":"QAR","minInvoiceAmount":1},{"code":"RON","minInvoiceAmount":1},{"code":"RSD","minInvoiceAmount":1},{"code":"RWF","minInvoiceAmount":1},{"code":"SAR","minInvoiceAmount":1},{"code":"SBD","minInvoiceAmount":1},{"code":"SCR","minInvoiceAmount":1},{"code":"SEK","minInvoiceAmount":1},{"code":"SGD","minInvoiceAmount":1},{"code":"SRD","minInvoiceAmount":1},{"code":"THB","minInvoiceAmount":1},{"code":"TND","minInvoiceAmount":1},{"code":"TOP","minInvoiceAmount":1},{"code":"TRY","minInvoiceAmount":1},{"code":"TTD","minInvoiceAmount":1},{"code":"TZS","minInvoiceAmount":1},{"code":"UAH","minInvoiceAmount":1},{"code":"UGX","minInvoiceAmount":1},{"code":"UYU","minInvoiceAmount":3},{"code":"VND","minInvoiceAmount":1},{"code":"VUV","minInvoiceAmount":1},{"code":"WST","minInvoiceAmount":1},{"code":"ZAR","minInvoiceAmount":4},{"code":"ZMW","minInvoiceAmount":1}]},"HostPlan:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"HostPlan","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"}},"__APOLLO_VARIABLES__":{"slug":"mochajs","nbContributorsPerContributeCard":4},"__APOLLO_ERROR__":null,"__APOLLO_QUERY_DATA__":{"Collective":{"__typename":"Collective","id":58,"idV2":"xrmvrwng-4kj03dpb-9z6z57oy-l9e8xbaj","slug":"mochajs","path":"/mochajs","name":"Mocha","hasHosting":false,"description":"☕️ Classic, reliable, trusted test framework for Node.js and the browser","longDescription":"\u003cdiv\u003eMocha is a feature-rich JavaScript test framework running on Node.js and the browser, making asynchronous testing reliable and fun. Mocha tests run serially or in parallel, allowing for flexible and accurate reporting, while mapping uncaught exceptions to the correct test cases. \u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003ch3\u003eStats\u003c/h3\u003e\u003cul\u003e\u003cli\u003eMocha is downloaded roughly 12M times per week \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.npmjs.com%2Fpackage%2Fmocha\"\u003eon NPM\u003c/a\u003e.\u003c/li\u003e\u003cli\u003eThe repo has more than 20k stars and 30k unique visitors per month.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr /\u003eDisclaimer: This Collective is run by and for the benefit of the independent contributors to the Mocha open source software project. This Collective is not endorsed or administered by the OpenJS Foundation; the OpenJS Foundation does not receive and has no control over any funds contributed; the OpenJS Foundation does not direct or otherwise supervise the actions of any contributor to the Mocha project; and all donations made will be expended for the private benefit of or otherwise to reimburse individuals that do not have an employer/employee, contractor, or other agency relationship with the OpenJS Foundation. The Mocha marks used herein are used under license from the OpenJS Foundation for the benefit of the open source software community.\u003cbr /\u003e\u003cbr /\u003eSponsoring Mocha does not guarantee ad placement on mochajs.org. The Mocha project reserves the right to restrict placement for any reason, including, but not limited to, excluding obvious spam.\u003c/div\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/5d0b1160-20c6-11e8-9fc9-47523ab65bdd.png","backgroundImageUrl":"https://images.opencollective.com/mochajs/607ad9a/background.png","twitterHandle":null,"repositoryUrl":"https://github.com/mochajs/mocha","website":"https://mochajs.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://mochajs.org/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/mochajs/mocha"}],"location":null,"tags":["open source","testing","bdd","test","javascript","node.js","typescript"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Fri Mar 18 2016 00:00:00 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{"key":"4cd6144d-1a6d-4f0c-bd28-1f84ae5b6df4"}],"editor":"html","features":{"rejectContribution":true},"githubOrg":"mochajs","moderation":{"rejectedCategories":[]},"collectivePage":{"primaryColor":"#8D6748"},"disablePublicExpenseSubmission":false},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":10,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://opencollective-production.s3.us-west-1.amazonaws.com/c645f600-20c5-11e8-9fc9-47523ab65bdd.png","imageUrl":"https://images.opencollective.com/mochajs/8e2f57f/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["INVOICE","RECEIPT"],"features":{"__typename":"CollectiveFeatures","id":"xrmvrwng-4kj03dpb-9z6z57oy-l9e8xbaj","ABOUT":"ACTIVE","CONNECTED_ACCOUNTS":"AVAILABLE","RECEIVE_FINANCIAL_CONTRIBUTIONS":"ACTIVE","RECURRING_CONTRIBUTIONS":"AVAILABLE","EVENTS":"AVAILABLE","PROJECTS":"AVAILABLE","USE_EXPENSES":"ACTIVE","RECEIVE_EXPENSES":"ACTIVE","FUNDS_GRANTS_MANAGEMENT":"DISABLED","COLLECTIVE_GOALS":"DISABLED","TOP_FINANCIAL_CONTRIBUTORS":"ACTIVE","CONVERSATIONS":"AVAILABLE","UPDATES":"ACTIVE","TEAM":"ACTIVE","CONTACT_FORM":"ACTIVE","RECEIVE_HOST_APPLICATIONS":"UNSUPPORTED","HOST_DASHBOARD":"UNSUPPORTED","TRANSACTIONS":"ACTIVE","PUBLIC_PROFILE":"ACTIVE"},"memberOf":[{"__typename":"Member","id":858713}],"stats":{"__typename":"CollectiveStatsType","id":58,"balance":7089870,"yearlyBudget":3015787,"backers":{"__typename":"BackersStatsType","id":58,"all":1187,"users":472,"organizations":708}},"connectedTo":[],"parentCollective":null,"host":{"__typename":"Organization","id":11004,"name":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","hasHosting":true,"location":{"__typename":"LocationType","id":"288932","country":"US"},"settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/for-donors-companies-organizations-and-individuals/refund-requests#refund-requests","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eVirtual cards are debit card numbers that can be issued to OSC's hosted initiatives for paying online for things like: recurring payments, online resources/tools, subscriptions, etc. They are directly tied to collectives' budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003eHow it works:\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/monthly)\u003c/strong\u003e. We will review your request and reply with any questions.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, the project must have a budget on their Open Collective account that exceeds the corresponding amount and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eRequirements/Policy:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e\u003c/li\u003e\u003cli\u003eIf a card has not been used for more than 15 months, the card will be frozen\u003c/li\u003e\u003cli\u003eIf no receipt has been uploaded to an expense after 30 days, the card will be frozen\u003c/li\u003e\u003cli\u003e​Admins are personally liable for misuse\u0026nbsp;\u003c/li\u003e\u003cli\u003eThe assigned card admin must complete a W-9 (for US-based admins) or a W-8BEN (for non-US admins) tax form before approval.\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eLimitations:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cbr\u003eIf you need to input Cardholder contact details/address:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003eSteps to set up the card that need to be performed by the collective admin:\u003c/div\u003e\u003cul\u003e\u003cli\u003eLog in to the Open Collective platform. In the left navigation, click on Virtual Cards -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003ch3\u003e​After a purchase is made:\u003c/h3\u003e\u003cdiv\u003eThe funds will be withdrawn from your initiative\u003c/div\u003e\u003cul\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt\u0026nbsp;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eIf the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":true,"autopauseUnusedCards":{"period":455,"enabled":true}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"restrictedTo":[]},{"section":"budget","isEnabled":true,"restrictedTo":[]}]},"hostCollective":{"id":11004},"paymentMethods":{"manual":{"title":"Bank Transfer (manual)","legacy":true,"features":{"recurring":false},"instructions":"Note: the instructions for transfers differ depending on whether you're sending from a US or non-US bank.\n\nMake sure to include the reference number, Invoice #, or project receiving the funds in the memo field.\n\nIf you have any questions or need an Invoice, please get in touch with us at hello@oscollective.org\n\n-------------------------------------\n\nFor US transfers (ACH or Wire)\n\nAmount: {amount}\nReference: {reference}\n\nAccount Number: 202525828483\nABA / Routing: 091311229\nSWIFT: CHFGUS44021\n\nAccount type: Business Checking\nBank name: Choice Financial Group\nBank address: 4501 23rd Avenue S, Fargo, ND 58104, USA\n\nAccount name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nInternational Bank Transfers (Wire)\nFor non-U.S. banks\n\nAmount: {amount}\nReference: {reference}\n\nRouting / Wire Number: 123205054\nSWIFT / BIC: UMPQUS6P\n\nAccount type: Business Checking\nBank Name: Columbia Bank\nBank Address: 450 Sansome St., Suite 120, San Francisco, CA 94111, United States\n\nAccount Name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nPlease note that it will take 3~5 business days to process your payment. If you don't see your contribution within a week, please contact us at hello@oscollective.org. \n\nNOTE: WE DO NOT ACCEPT CHECKS"}},"payoutsTwoFactorAuth":{"enabled":true,"rollingLimit":1000000},"newPlatformTipsLedger":true,"forceNewPaypalPayments":true,"disableCryptoContributions":false,"exportedTransactionsFieldSets":{"yptc":{"name":"YPTC","fields":["effectiveDate","legacyId","description","type","kind","group","netAmount","currency","isRefund","isRefunded","refundLegacyId","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","orderMemo","expenseType","payoutMethodType","accountingCategoryCode","accountingCategoryName","merchantId","paymentProcessorFee","taxAmount","shortId","shortGroup","shortRefundId","displayAmount","amount","balance"],"useFieldNames":false,"flattenTaxesAndPaymentProcessorFees":true},"a-team":{"name":"A Team","fields":["datetime","shortId","shortGroup","description","type","kind","isRefund","isRefunded","shortRefundId","displayAmount","amount","paymentProcessorFee","netAmount","balance","currency","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","expenseType","expenseTags","payoutMethodType","merchantId","orderMemo","taxAmount","refundLegacyId","accountingCategoryName","accountingCategoryCode","effectiveDate","legacyId","group","debitAndCreditAmounts"],"flattenTaxesAndPaymentProcessorFees":true},"yptc-id-to-group":{"name":"YPTC - ID to Group"