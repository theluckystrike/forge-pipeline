ER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":67299,"hasPublicProfile":true},"Member:594787":{"__typename":"Member","id":594787},"Member:783333":{"__typename":"Member","id":783333},"Member:847970":{"__typename":"Member","id":847970},"Member:848078":{"__typename":"Member","id":848078},"PlanType:26822":{"__typename":"PlanType","id":26822,"hostedCollectives":0},"Collective:26822":{"__typename":"Collective","id":26822,"idV2":"re0adkjr-v8xwm697-b3lq7z5n-4l93bgoy","slug":"mastodon","path":"/mastodon","name":"Mastodon","hasHosting":false,"description":"Mastodon is a free, open-source social network server based on ActivityPub","longDescription":"\u003cp\u003eMastodon is a \u003cstrong\u003efree, open-source social network server\u003c/strong\u003e based on ActivityPub. All servers of Mastodon are interoperable as a \u003cstrong\u003efederated network\u003c/strong\u003e, i.e. users on one server can seamlessly communicate with users from another one, including non-Mastodon software!\u003c/p\u003e\n\u003cp\u003eThe software has a friendly, polished interface, and many robust community moderation and anti-abuse features, as well as many fun goodies such as custom emojis.\u003c/p\u003e\n\u003cp\u003eThere are over 2,000 Mastodon servers out in the wild hosting about 1.6M users.\u003c/p\u003e","backgroundImage":null,"backgroundImageUrl":null,"twitterHandle":"joinmastodon","repositoryUrl":"https://github.com/mastodon/mastodon","website":"https://joinmastodon.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://joinmastodon.org/"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/joinmastodon"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/mastodon/mastodon"}],"location":null,"tags":["activity-stream","activitypub","mastodon","microblog","social-network","webfinger","open source"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Sat Dec 22 2018 04