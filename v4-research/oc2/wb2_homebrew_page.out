encollective.com/redirect?url=https%3A%2F%2Fbrew.sh%2F\"\u003eHomebrew\u003c/a\u003e is an open-source, free package manager for macOS, Linux and Windows (with the Windows Subsystem for Linux).\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eHomebrew is a non-profit project run entirely by volunteers. We need your funds to pay for software, hardware, hosting around continuous integration, maintainer contributions, travel to conferences and future improvements to the project. Every donation will be spent on making Homebrew better for our users.\u003c/div\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/249dbff0-72c3-11ec-86ac-5f2974615eed.jpeg","backgroundImageUrl":"https://images.opencollective.com/homebrew/263f2e0/background.png","twitterHandle":"MacHomebrew","repositoryUrl":"https://github.com/Homebrew","website":"https://brew.sh/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://brew.sh/"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/MacHomebrew"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/Homebrew"},{"__typename":"SocialLink","type":"MASTODON","url":"https://fosstodon.org/@homebrew"}],"location":null,"tags":["open source","macos","homebrew"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Fri Nov 05 2021 13:25:15 GMT+0000 (Coordinated Universal Time)","settings":{"features":{"conversations":true},"githubOrg":"Homebrew","moderation":{"rejectedCategories":[]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"events","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION