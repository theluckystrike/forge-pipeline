Notice","fields":["name","slug","website","adminCount","adminEmails","balance","lastContributionDate","valueOfContributionsAllTime","lastExpenseDate"]},"inactive-collectives-(for-2-years)":{"name":"Inactive collectives (for 2 years)","fields":["name","slug","type","approvedAt","balance","adminCount","adminEmails","lastContributionDate","lastExpenseDate","totalNumberOfContributions"]}},"autoAssignExpenseCategoryPredictions":true},"plan":{"__ref":"PlanType:11004"},"policies":{"__ref":"Policies:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"}},"Contributor:447882":{"__typename":"Contributor","id":"447882","name":"Mike McQuaid","roles":["ADMIN","BACKER","CONTRIBUTOR"],"isAdmin":true,"isCore":true,"isBacker":true,"since":"2021-11-05T13:25:15.125Z","image":"https://images.opencollective.com/mikemcquaid/18b9eb8/avatar.png","description":"Project Leader","collectiveSlug":"mikemcquaid","totalAmountDonated":28675,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":447882,"hasPublicProfile":true},"Contributor:447900":{"__typename":"Contributor","id":"447900","name":"Issy Long","roles":["ADMIN","CONTRIBUTOR"],"isAdmin":true,"isCore":true,"isBacker":false,"since":"2021-11-29T22:03:11.281Z","image":"https://images.opencollective.com/issyl0/528f7ba/avatar.png","description":"","collectiveSlug":"issyl0","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":447900,"hasPublicProfile":false},"Contributor:471478":{"__typename":"Contributor","id":"471478","name":"Rui Chen","roles":["ADMIN","CONTRIBUTOR"],"isAdmin":true,"isCore":true,"isBacker":false,"since":"2022-01-11T00:04:14.512Z","image":"https://images.opencollective.com/rui-chen/avatar.png","description":"","collectiveSlug":"rui-chen","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":471478,"hasPublicProfile":true},"Contributor:488783":{"__typ