gruoyu","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":694156,"hasPublicProfile":true},"Contributor:694752":{"__typename":"Contributor","id":"694752","name":"Nanda H Krishna","roles":["ADMIN","CONTRIBUTOR"],"isAdmin":true,"isCore":true,"isBacker":false,"since":"2024-07-18T19:00:27.455Z","image":"https://images.opencollective.com/nandahkrishna/e132b40/avatar.png","description":"","collectiveSlug":"nandahkrishna","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":694752,"hasPublicProfile":true},"Contributor:696144":{"__typename":"Contributor","id":"696144","name":"Thierry Moisan","roles":["ADMIN","CONTRIBUTOR"],"isAdmin":true,"isCore":true,"isBacker":false,"since":"2024-07-23T19:00:30.264Z","image":"https://images.opencollective.com/thierry-moisan/avatar.png","description":"","collectiveSlug":"thierry-moisan","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":696144,"hasPublicProfile":true},"Contributor:614861":{"__typename":"Contributor","id":"614861","name":"Sam Ford","roles":["ADMIN","CONTRIBUTOR"],"isAdmin":true,"isCore":true,"isBacker":false,"since":"2024-07-31T13:35:36.898Z","image":"https://images.opencollective.com/samford/avatar.png","description":"","collectiveSlug":"samford","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":614861,"hasPublicProfile":true},"Contributor:590770":{"__typename":"Contributor","id":"590770","name":"Michka Popoff","roles":["ADMIN","CONTRIBUTOR"],"isAdmin":true,"isCore":true,"isBacker":false,"since":"2024-08-29T12:59:24.391Z","image":"https://images.opencollective.com/michka-popoff/avatar.png","description":"PLC Member","collectiveSlug":"michka-popoff","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,