","hostOnly":false,"instructions":null,"name":"Grants - Other","friendlyName":"","expensesTypes":["GRANT"],"createdAt":"2023-11-07T16:34:16.637Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:3vjrkx5l-mnv904qj-ybq8bwa7-zdygoe3d":{"__typename":"AccountingCategory","id":"3vjrkx5l-mnv904qj-ybq8bwa7-zdygoe3d","kind":"EXPENSE","code":"7031","hostOnly":false,"instructions":"\u003cdiv\u003eSelect when paying for project materials, events, or office supplies. \u003c/div\u003e","name":"Expenses · Collective Ops","friendlyName":"Collective Ops","expensesTypes":null,"createdAt":"2024-04-08T22:39:43.121Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:3vjrkx5l-mnv904qj-jmq8bwa7-zdygoe3d":{"__typename":"AccountingCategory","id":"3vjrkx5l-mnv904qj-jmq8bwa7-zdygoe3d","kind":"EXPENSE","code":"7032","hostOnly":false,"instructions":null,"name":"Expenses - Donations \u0026 Sponsorships","friendlyName":"Donations \u0026 Sponsorships","expensesTypes":null,"createdAt":"2024-04-19T17:56:15.046Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:oeejoxl3-az45w9pa-kw6y870m-gkbrvdn8":{"__typename":"AccountingCategory","id":"oeejoxl3-az45w9pa-kw6y870m-gkbrvdn8","kind":"EXPENSE","code":"7033","hostOnly":false,"instructions":null,"name":"Expenses - Travel","friendlyName":"Travel","expensesTypes":null,"createdAt":"2024-04-19T17:56:48.300Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:oeejoxl3-az45w9pa-xeqy870m-gkbrvdn8":{"__typename":"AccountingCategory","id":"oeejoxl3-az45w9pa-xeqy870m-gkbrvdn8","kind":"EXPENSE","code":"7034","hostOnly":false,"instructions":null,"name":"Expenses · Meals \u0026 Entertainment","friendlyName":"Meals \u0026 Entertainment","expensesTypes":null,"createdAt":"2024-04-08T22:55:01.833Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:z53kzxy4-v07wlr6m-xkpmj9no-8agdbe57":{"__typename":"AccountingCategory","id":"z53kzxy4-v07wlr6m-xkpmj9no-8agdbe57","kind":"EXPENSE","code":"7035","hostOnly":false,"instructions":null,"name":"Expenses - Office \u0026 Event Space","friendlyName":"Office \u0026 Event Space","expensesTypes":null,"createdAt":"2024-04-19T17:57:31.327Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:m5ax8emk-7lnw54q7-axqgyvj0-o93zdrbn":{"__typename":"AccountingCategory","id":"m5ax8emk-7lnw54q7-axqgyvj0-o93zdrbn","kind":"EXPENSE","code":"7036","hostOnly":false,"instructions":null,"name":"Expenses - Advertising \u0026 Marketing","friendlyName":"Advertising \u0026 Marketing Tangibles","expensesTypes":null,"createdAt":"2024-04-19T17:58:06.340Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:y7mywxoz-3409rl6k-kb6venbd-j7gk85ag":{"__typename":"AccountingCategory","id":"y7mywxoz-3409rl6k-kb6venbd-j7gk85ag","kind":"EXPENSE","code":"7037","hostOnly":false,"instructions":null,"name":"Expenses - Hosting \u0026 Subscriptions","friendlyName":"Hosting \u0026 Subscriptions","expensesTypes":null,"createdAt":"2024-04-19T17:58:52.069Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:z53kzxy4-v07wlr6m-emqmj9no-8agdbe57":{"__typename":"AccountingCategory","id":"z53kzxy4-v07wlr6m-emqmj9no-8agdbe57","kind":"EXPENSE","code":"7038","hostOnly":false,"instructions":"\u003cdiv\u003eSelect when purchasing equipment (laptop, hardware, phones, etc).\u003c/div\u003e","name":"Expenses · Equipment \u0026 Hardware","friendlyName":"Equipment \u0026 Hardware","expensesTypes":null,"createdAt":"2024-04-08T23:00:08.338Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:388rzown-xl9e50px-xbpymvbd-gk7j43a9":{"__typename":"AccountingCategory","id":"388rzown-xl9e50px-xbpymvbd-gk7j43a9","kind":"EXPENSE","code":"7039","hostOnly":false,"instructions":null,"name":"DO NOT USE","friendlyName":"","expensesTypes":null,"createdAt":"2024-04-19T17:50:37.285Z","appliesTo":"HOST"},"AccountingCategory:388rzown-xl9e50px-n3qymvbd-gk7j43a9":{"__typename":"AccountingCategory","id":"388rzown-xl9e50px-n3qymvbd-gk7j43a9","kind":"EXPENSE","code":"7100","hostOnly":false,"instructions":"\u003cdiv\u003eSelect for any expenses related to a payroll processor for w2 FTE only (Velocity...)\u003c/div\u003e","name":"PAYROLL- Collectives","friendlyName":"","expensesTypes":null,"createdAt":"2024-04-08T22:19:47.295Z","appliesTo":"HOSTED_COLLECTIVES"},"Policies:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"Policies","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k","EXPENSE_CATEGORIZATION":{"__typename":"EXPENSE_CATEGORIZATION","requiredForExpenseSubmitters":false,"requiredForCollectiveAdmins":false}},"Host:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"Host","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k","legacyId":11004,"name":"Open Source Collective","legalName":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","currency":"USD","isHost":true,"expensePolicy":"\u003cdiv\u003e\u003cstrong\u003eFile an invoice only when you are requesting payment for services you personally performed.\u003c/strong\u003e We can only pay the individual who completed the work -- no third parties or friends. The person who performed the work must be the owner of the account receiving payment.\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eWe have \u003cstrong\u003estrict requirements\u003c/strong\u003e for what we can and cannot process. Certain information is \u003cstrong\u003erequired\u003c/strong\u003e on all invoices, and we cannot process payment if required information is missing.\u0026nbsp;\u003c/div\u003e\u003cdiv\u003ePlease review our full policies before submitting:\u003cbr\u003e\u003ca href=\"https://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\"\u003ehttps://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\u003c/a\u003e\u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eIf your expense is missing required information or documentation, you will be asked to revise it before processing can begin. \u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003e\u003cstrong\u003eProcessing and Payment:\u0026nbsp;\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eExpenses are processed \u003cstrong\u003etwice weekly\u003c/strong\u003e after approval by a Collective administrator and a secondary OSC review\u003c/li\u003e\u003cli\u003ePayments are made via \u003cstrong\u003ePayPal or Wise (bank transfer)\u003c/strong\u003e\u003c/li\u003e\u003cli\u003ePayments are limited to countries supported by these providers\u003c/li\u003e\u003cli\u003eIf you use PayPal, you may be required to complete a \u003cstrong\u003eKYC\u003c/strong\u003e process\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003eAn uploaded invoice is \u003cstrong\u003enot required\u003c/strong\u003e -- the information entered in the expense form is sufficient.\u003cbr\u003e If you choose to upload an invoice, address it to:\u003cbr\u003e \u003cbr\u003e\u003cstrong\u003eCollective/Project Name, Open Source Collective\u003c/strong\u003e\u003cbr\u003e 440 N. Barranca Avenue #3939\u003cbr\u003e Covina, CA 91723, USA\u003c/div\u003e","website":"https://oscollective.org/","settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/faq/expenses#can-i-refund-a-donation-or-get-a-refund-for-one-i-have-made","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eUpdate as of December 2025: We’re currently unable to issue virtual cards, but we’re exploring options for the future. We apologize for any inconvenience.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eVirtual cards are debit card numbers that can be issued to OSC's hosted initiatives for paying online for things like: recurring payments, utility bills, online resources/tools, subscriptions, vendors (e.g. wholesale distributors), etc. They are directly tied to collectives' budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003eHow it works:\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/monthly)\u003c/strong\u003e. The virtual card with that limit will be set up for your collective.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, initiative must have a budget on their Open Collective account that exceeds the corresponding amount, and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eRequirements/Policy:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eInitiatives must have a minimum of 2 admin members\u003c/li\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e​\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eLimitations:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eIf you need to input Cardholder contact details/address:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003eSteps:\u003c/div\u003e\u003ch3\u003eSetup the card:\u003cbr\u003eInitiative admins request the card from OSC:\u003c/h3\u003e\u003cul\u003e\u003cli\u003eVisit your initiative's page\u003c/li\u003e\u003cli\u003eClick Actions -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003ch3\u003e​After a purchase is made:\u003c/h3\u003e\u003cdiv\u003eThe funds will be withdrawn from your initiative\u003c/div\u003e\u003cul\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt. \u003cstrong\u003e(If the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt)\u003c/strong\u003e.\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":false,"autopauseUnusedCards":{"period":90,"enabled":false}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"restrictedTo":[]},{"section":"budget","isEnabled":true,"restrictedTo":[]}]},"hostCollective":{"id":11004},"paymentMethods":{"manual":{"title":"Bank Transfer (manual)","legacy":true,"features":{"recurring":false},"instructions":"Note: the instructions for transfers differ depending on whether you're sending from a US or non-US bank.\n\nMake sure to include the reference number, Invoice #, or project receiving the funds in the memo field.\n\nIf you have any questions or need an Invoice, please get in touch with us at hello@oscollective.org\n\n-------------------------------------\n\nFor US transfers (ACH or Wire)\n\nAmount: {amount}\nReference: {reference}\n\nAccount Number: 202525828483\nABA / Routing: 091311229\nSWIFT: CHFGUS44021\n\nAccount type: Business Checking\nBank name: Choice Financial Group\nBank address: 4501 23rd Avenue S, Fargo, ND 58104, USA\n\nAccount name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nInternational Bank Transfers (Wire)\nFor non-U.S. banks\n\nAmount: {amount}\nReference: {reference}\n\nRouting / Wire Number: 123205054\nSWIFT / BIC: UMPQUS6P\n\nAccount type: Business Checking\nBank Name: Columbia Bank\nBank Address: 450 Sansome St., Suite 120, San Francisco, CA 94111, United States\n\nAccount Name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nPlease note that it will take 3~5 business days to process your payment. If you don't see your contribution within a week, please contact us at hello@oscollective.org. \n\nNOTE: WE DO NOT ACCEPT CHECKS"}},"payoutsTwoFactorAuth":{"enabled":true,"rollingLimit":1000000},"forceNewPaypalPayments":true,"disableCryptoContributions":false,"exportedTransactionsFieldSets":{"yptc":{"name":"YPTC","fields":["effectiveDate","legacyId","description","type","kind","group","netAmount","currency","isRefund","isRefunded","refundLegacyId","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","orderMemo","expenseType","payoutMethodType","accountingCategoryCode","accountingCategoryName","merchantId","paymentProcessorFee","taxAmount","shortId","shortGroup","shortRefundId","displayAmount","amount","balance"],"useFieldNames":false,"flattenTaxesAndPaymentProcessorFees":true},"a-team":{"name":"A Team","fields":["datetime","shortId","shortGroup","description","type","kind","isRefund","isRefunded","shortRefundId","displayAmount","amount","paymentProcessorFee","netAmount","balance","currency","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","expenseType","expenseTags","payoutMethodType","merchantId","orderMemo","taxAmount","refundLegacyId","accountingCategoryName","accountingCategoryCode","effectiveDate","legacyId","group","debitAndCreditAmounts"],"flattenTaxesAndPaymentProcessorFees":true},"yptc-id-to-group":{"name":"YPTC - ID to Group","fields":["datetime","shortId","shortGroup"],"useFieldNames":false,"flattenTaxesAndPaymentProcessorFees":false},"yptc-new-export-draft":{"name":"YPTC - New Export Draft","fields":["effectiveDate","description","type","kind","merchantId","amount","netAmount","paymentProcessorFee","paymentMethodType","paymentMethodService","accountSlug","accountName","oppositeAccountSlu