":"KES","minInvoiceAmount":1},{"code":"KGS","minInvoiceAmount":1},{"code":"KHR","minInvoiceAmount":1},{"code":"KRW","minInvoiceAmount":1},{"code":"KWD","minInvoiceAmount":4},{"code":"LAK","minInvoiceAmount":1},{"code":"LKR","minInvoiceAmount":1},{"code":"MAD","minInvoiceAmount":1},{"code":"MNT","minInvoiceAmount":1},{"code":"MOP","minInvoiceAmount":1},{"code":"MUR","minInvoiceAmount":1},{"code":"MXN","minInvoiceAmount":1},{"code":"MYR","minInvoiceAmount":1},{"code":"NAD","minInvoiceAmount":1},{"code":"NIO","minInvoiceAmount":1},{"code":"NOK","minInvoiceAmount":1},{"code":"NPR","minInvoiceAmount":1},{"code":"NZD","minInvoiceAmount":1},{"code":"OMR","minInvoiceAmount":3},{"code":"PEN","minInvoiceAmount":3},{"code":"PHP","minInvoiceAmount":1},{"code":"PKR","minInvoiceAmount":1},{"code":"PLN","minInvoiceAmount":1},{"code":"PYG","minInvoiceAmount":1},{"code":"QAR","minInvoiceAmount":1},{"code":"RON","minInvoiceAmount":1},{"code":"RSD","minInvoiceAmount":1},{"code":"RWF","minInvoiceAmount":1},{"code":"SAR","minInvoiceAmount":1},{"code":"SCR","minInvoiceAmount":1},{"code":"SEK","minInvoiceAmount":1},{"code":"SGD","minInvoiceAmount":1},{"code":"SRD","minInvoiceAmount":1},{"code":"THB","minInvoiceAmount":1},{"code":"TND","minInvoiceAmount":1},{"code":"TRY","minInvoiceAmount":1},{"code":"TZS","minInvoiceAmount":1},{"code":"UAH","minInvoiceAmount":1},{"code":"UGX","minInvoiceAmount":1},{"code":"UYU","minInvoiceAmount":3},{"code":"VND","minInvoiceAmount":1},{"code":"ZAR","minInvoiceAmount":3}]},"HostPlan:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"HostPlan","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"AccountingCategory:xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj":{"__typename":"AccountingCategory","id":"xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj","kind":"EXPENSE","code":"7011","hostOnly":false,"instructions":"\u003cdiv\u003eSelect when paying admin support staff, etc.\u003c/div\u003e","name":"Administrative","friendlyName":"Administrative","expensesTypes":null,"createdAt":"2024-04-08