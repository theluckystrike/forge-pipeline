":"AccountingCategory:oeejoxl3-az45w9pa-xeqy870m-gkbrvdn8"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-xkpmj9no-8agdbe57"},{"__ref":"AccountingCategory:m5ax8emk-7lnw54q7-axqgyvj0-o93zdrbn"},{"__ref":"AccountingCategory:y7mywxoz-3409rl6k-kb6venbd-j7gk85ag"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-emqmj9no-8agdbe57"},{"__ref":"AccountingCategory:388rzown-xl9e50px-xbpymvbd-gk7j43a9"},{"__ref":"AccountingCategory:388rzown-xl9e50px-n3qymvbd-gk7j43a9"}]},"policies":{"__ref":"Policies:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"isFirstPartyHost":true,"isVerified":false},"Collective:re0adkjr-v8xwm697-7akq7z5n-4l93bgoy":{"__typename":"Collective","id":"re0adkjr-v8xwm697-7akq7z5n-4l93bgoy","legacyId":14622,"slug":"curl","type":"COLLECTIVE","imageUrl":"https://images.opencollective.com/curl/2b984f3/logo.png","backgroundImageUrl":null,"twitterHandle":null,"name":"curl","currency":"USD","isArchived":false,"isActive":true,"settings":{"goals":[{"key":38907,"type":"yearlyBudget","title":"server cost","amount":260000,"description":"This amount is half the actual server cost as it is not used for curl services alone. We estimate curl and related matters to be roughly half the traffic and \"issues\" on the machine."},{"key":25671,"type":"yearlyBudget","title":"curl up","amount":460000,"description":"Annual developers conference. Needs a room, food, tshirts and other arrangements in a city that people can reach without too much trouble. If possible, we should consider sponsoring attendees who can't otherwise afford it."},{"key":77452,"type":"yearlyBudget","title":"bug bounty program","amount":760000,"description":"By funding this program we can pay security researchers for finding security problems in curl and libcurl."}],"editor":"html","features":{"conversations":true},"githubRepo":"curl/curl","moderation":{"rejectedCategories":[]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":false,"restrictedTo":null},{"name":"CONTRIBUTE","type":"CATEGORY","sectio