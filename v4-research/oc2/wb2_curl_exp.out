:54,"offset":0,"limit":10,"nodes":[{"__ref":"Expense:0n4gx0br-ov5m96n3-v9jqd8lk-3ey7jzwa"},{"__ref":"Expense:zzaxon79-3jy8gpl4-8kj6brkd-emwl5v04"},{"__ref":"Expense:rmvrwng4-kj03dpby-gd0qz57o-yl9e8xba"},{"__ref":"Expense:8a47byg9-nxozdp8n-e8mpmjlv-03rek5w8"},{"__ref":"Expense:0n4gx0br-ov5m96nn-vkw6d8lk-3ey7jzwa"},{"__ref":"Expense:8a47byg9-nxozdp8n-497pmjlv-03rek5w8"},{"__ref":"Expense:8a47byg9-nxozdp8n-xk9pmjlv-03rek5w8"},{"__ref":"Expense:eejoxl3a-z45w9paj-5akpy870-mgkbrvdn"},{"__ref":"Expense:0n4gx0br-ov5m96nn-0x86d8lk-3ey7jzwa"},{"__ref":"Expense:dgm9bnk8-0437xqrx-yooqvzeo-ljdayw5r"}]},"expenses({\"host\":{\"slug\":\"curl\"},\"limit\":1,\"payoutMethodType\":\"BANK_ACCOUNT\",\"status\":\"SCHEDULED_FOR_PAYMENT\"})":{"__typename":"ExpenseCollection","totalCount":0}}},"__APOLLO_VARIABLES__":{"account":{"slug":"curl"},"limit":10,"offset":0,"sort":{"field":"CREATED_AT","direction":"DESC"},"direction":"RECEIVED","accountSlug":"curl"},"__APOLLO_ERROR__":null,"__APOLLO_QUERY_DATA__":{"account":{"__typename":"Collective","id":"re0adkjr-v8xwm697-7akq7z5n-4l93bgoy","legacyId":14622,"slug":"curl","type":"COLLECTIVE","imageUrl":"https://images.opencollective.com/curl/2b984f3/logo.png","backgroundImageUrl":null,"twitterHandle":null,"name":"curl","currency":"USD","isArchived":false,"isActive":true,"settings":{"goals":[{"key":38907,"type":"yearlyBudget","title":"server cost","amount":260000,"description":"This amount is half the actual server cost as it is not used for curl services alone. We estimate curl and related matters to be roughly half the traffic and \"issues\" on the machine."},{"key":25671,"type":"yearlyBudget","title":"curl up","amount":460000,"description":"Annual developers conference. Needs a room, food, tshirts and other arrangements in a city that people can reach without too much trouble. If possible, we should consider sponsoring attendees who can't otherwise afford it."},{"key":77452,"type":"yearlyBudget","title":"bug bounty program","amount":760000,"description":"By funding this program we can pay security researchers for finding security problems in curl and libcurl."}],"editor":"html","features":{"conversations":true},"githubRepo":"curl/curl","moderation":{"rejectedCategories":[]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":false,"restrictedTo":null},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"events","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"projects","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"useNewSections":true,"legacySectionsBackup":[{"section":"goals","isEnabled":false},{"section":"contribute","isEnabled":true},{"section":"updates","isEnabled":false,"restrictedTo":[]},{"section":"conversations","isEnabled":true},{"section":"budget","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"recurring-contributions","isEnabled":true},{"section":"about","isEnabled":true}]},"crowdfundingRedesign":{"profile":{"name":"curl","cover":{"url":null,"type":"IMAGE"},"description":"client-side internet transfers","longDescription":"\u003cdiv\u003eA command line tool and library for transferring data with URL syntax.\u003cbr /\u003e\u003cbr /\u003ePlease note that sponsorships and donations are exactly that: donations to the curl project. They are used to help and further the project as the project leadership deems best. Not a purchase of any specific service or offer in return.\u003cbr /\u003e\u003cbr /\u003eWe love your sponsorship!\u003c/div\u003e"}},"disablePublicExpenseSubmission":false},"createdAt":"2018-04-04T12:00:43.468Z","supportedExpenseTypes":["INVOICE","RECEIPT"],"expensesTags":[{"__typename":"TagStat","id":"curl up 2024","tag":"curl up 2024"},{"__typename":"TagStat","id":"marketing","tag":"marketing"},{"__typename":"TagStat","id":"hardware","tag":"hardware"},{"__typename":"TagStat","id":"fund","tag":"fund"},{"__typename":"TagStat","id":"travel","tag":"travel"}],"features":{"__typename":"CollectiveFeatures","id":"re0adkjr-v8xwm697-7akq7z5n-4l93bgoy","ABOUT":"ACTIVE","CONNECTED_ACCOUNTS":"AVAILABLE","RECEIVE_FINANCIAL_CONTRIBUTIONS":"ACTIVE","RECURRING_CONTRIBUTIONS":"AVAILABLE","EVENTS":"AVAILABLE","PROJECTS":"AVAILABLE","USE_EXPENSES":"ACTIVE","RECEIVE_EXPENSES":"ACTIVE","RECEIVE_GRANTS":"DISABLED","COLLECTIVE_GOALS":"DISABLED","TOP_FINANCIAL_CONTRIBUTORS":"ACTIVE","CONVERSATIONS":"AVAILABLE","UPDATES":"ACTIVE","TEAM":"ACTIVE","CONTACT_FORM":"ACTIVE","RECEIVE_HOST_APPLICATIONS":"UNSUPPORTED","HOST_DASHBOARD":"UNSUPPORTED","TRANSACTIONS":"ACTIVE","REQUEST_VIRTUAL_CARDS":"DISABLED"},"stats":{"__typename":"AccountStats","id":"re0adkjr-v8xwm697-7akq7z5n-4l93bgoy","balance":{"__typename":"Amount","valueInCents":12896754,"currency":"USD"},"balanceWithBlockedFunds":{"__typename":"Amount","valueInCents":12896754,"currency":"USD"}},"isApproved":true,"host":{"__typename":"Host","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k","legacyId":11004,"name":"Open Source Collective","legalName":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","currency":"USD","isHost":true,"expensePolicy":"\u003cdiv\u003e\u003cstrong\u003eFile an invoice only when you are requesting payment for services you personally performed.\u003c/strong\u003e We can only pay the individual who completed the work -- no third parties or friends. The person who performed the work must be the owner of the account receiving payment.\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eWe have \u003cstrong\u003estrict requirements\u003c/strong\u003e for what we can and cannot process. Certain information is \u003cstrong\u003erequired\u003c/strong\u003e on all invoices, and we cannot process payment if required information is missing.\u0026nbsp;\u003c/div\u003e\u003cdiv\u003ePlease review our full policies before submitting:\u003cbr\u003e\u003ca href=\"https://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\"\u003ehttps://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\u003c/a\u003e\u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eIf your expense is missing required information or documentation, you will be asked to revise it before processing can begin. \u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003e\u003cstrong\u003eProcessing and Payment:\u0026nbsp;\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eExpenses are processed \u003cstrong\u003etwice weekly\u003c/strong\u003e after approval by a Collective administrator and a secondary OSC review\u003c/li\u003e\u003cli\u003ePayments are made via \u003cstrong\u003ePayPal or Wise (bank transfer)\u003c/strong\u003e\u003c/li\u003e\u003cli\u003ePayments are limited to countries supported by these providers\u003c/li\u003e\u003cli\u003eIf you use PayPal, you may be required to complete a \u003cstrong\u003eKYC\u003c/strong\u003e process\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003eAn uploaded invoice is \u003cstrong\u003enot required\u003c/strong\u003e -- the information entered in the expense form is sufficient.\u003cbr\u003e If you choose to upload an invoice, address it to:\u003cbr\u003e \u003cbr\u003e\u003cstrong\u003eCollective/Project Name, Open Source Collective\u003c/strong\u003e\u003cbr\u003e 440 N. Barranca Avenue #3939\u003cbr\u003e Covina, CA 91723, USA\u003c/div\u003e","website":"https://oscollective.org/","settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/faq/expenses#can-i-refund-a-donation-or-get-a-refund-for-one-i-have-made","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eUpdate as of December 2025: We’re currently unable to issue virtual cards, but we’re exploring options for the future. We apologize for any inconvenience.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eVirtual cards are debit card numbers that can be issued to OSC's hosted initiatives for paying online for things like: recurring payments, utility bills, online resources/tools, subscriptions, vendors (e.g. wholesale distributors), etc. They are directly tied to collectives' budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003eHow it works:\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/monthly)\u003c/strong\u003e. The virtual card with that limit will be set up for your collective.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, initiative must have a budget on their Open Collective account that exceeds the corresponding amount, and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eRequirements/Policy:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eInitiatives must have a minimum of 2 admin members\u003c/li\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e​\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eLimitations:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eIf you need to input Cardholder contact details/address:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003eSteps:\u003c/div\u003e\u003ch3\u003eSetup the card:\u003cbr\u003eInitiative admins request the card from OSC:\u003c/h3\u003e\u003cul\u003e\u003cli\u003eVisit your initiative's page\u003c/li\u003e\u003cli\u003eClick Actions -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003ch3\u003e​After a purchase is made:\u003c/h3\u003e\u003cdiv\u003eThe funds will be withdrawn from your initiative\u003c/div\u003e\u003cul\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt. \u003cstrong\u003e(If the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt)\u003c/strong\u003e.\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":false,"autopauseUnusedCards":{"period":90,"enabled":false}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"rest