ode":"OMR","minInvoiceAmount":3},{"code":"PEN","minInvoiceAmount":3},{"code":"PGK","minInvoiceAmount":1},{"code":"PHP","minInvoiceAmount":1},{"code":"PKR","minInvoiceAmount":1},{"code":"PLN","minInvoiceAmount":1},{"code":"PYG","minInvoiceAmount":1},{"code":"QAR","minInvoiceAmount":1},{"code":"RON","minInvoiceAmount":1},{"code":"RSD","minInvoiceAmount":1},{"code":"RWF","minInvoiceAmount":1},{"code":"SAR","minInvoiceAmount":1},{"code":"SBD","minInvoiceAmount":1},{"code":"SCR","minInvoiceAmount":1},{"code":"SEK","minInvoiceAmount":1},{"code":"SGD","minInvoiceAmount":1},{"code":"SRD","minInvoiceAmount":1},{"code":"THB","minInvoiceAmount":1},{"code":"TND","minInvoiceAmount":1},{"code":"TOP","minInvoiceAmount":1},{"code":"TRY","minInvoiceAmount":1},{"code":"TTD","minInvoiceAmount":1},{"code":"TZS","minInvoiceAmount":1},{"code":"UAH","minInvoiceAmount":1},{"code":"UGX","minInvoiceAmount":1},{"code":"UYU","minInvoiceAmount":3},{"code":"VND","minInvoiceAmount":1},{"code":"VUV","minInvoiceAmount":1},{"code":"WST","minInvoiceAmount":1},{"code":"ZAR","minInvoiceAmount":4},{"code":"ZMW","minInvoiceAmount":1}]},"HostPlan:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"HostPlan","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"AccountingCategory:xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj":{"__typename":"AccountingCategory","id":"xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj","kind":"EXPENSE","code":"7011","hostOnly":false,"instructions":"\u003cdiv\u003eSelect when paying admin support staff, etc.\u003c/div\u003e","name":"Administrative","friendlyName":"Administrative","expensesTypes":null,"createdAt":"2024-04-08T21:55:41.044Z","appliesTo":"HOSTED_COLLECTIVES"},"AccountingCategory:703k0exg-znm8yj64-n9q5wao9-r7b4dlvr":{"__typename":"AccountingCategory","id":"703k0exg-znm8yj64-n9q5wao9-r7b4dlvr","kind":"EXPENSE","code":"7014","hostOnly":false,"instructions":"\u003cdiv\u003eSelect when paying Lawyer fees, etc.\u003c/div\u003e","name":"Legal \u0026 Professional Services","friendlyName":"Legal \u0026 Pr