ojects; it aims to provide fast tools to maintain the said projects' healthy\u003cbr /\u003e\u003cbr /\u003eBiome provides and owns all its tools: parser, formatter, analyzer, etc.\u003cbr /\u003e\u003cbr /\u003eBiome is fast and reliable, it provides high-quality diagnostics, and it has its own LSP server out of the box. \u003cbr /\u003e\u003cbr /\u003eUsers can customise all the tools Biome provides with one configuration file.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cblockquote\u003e\u003cstrong\u003eDisclaimer:\u003c/strong\u003e \u003cem\u003e“All contributions are donations. No goods or services are expected in return. Any requests for refunds for those purposes will be rejected.” \u003c/em\u003e\u003c/blockquote\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/account-banner/2cf5afca-845a-4b82-a33d-dc919313ecf1/slogan-light-transparent-x1.png","backgroundImageUrl":"https://images.opencollective.com/biome/e669640/background.png","twitterHandle":null,"repositoryUrl":"https://github.com/biomejs","website":"https://biomejs.dev/","socialLinks":[{"__typename":"SocialLink","type":"DISCORD","url":"https://discord.gg/BypW39g6Yc"},{"__typename":"SocialLink","type":"WEBSITE","url":"https://biomejs.dev/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/biomejs"}],"location":null,"tags":["linter","formatter","open source","javascript","typescript","toolchain"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Mon Aug 28 2023 08:51:06 GMT+0000 (Coordinated Universal Time)","settings":{"features":{"conversations":true},"githubRepo":"biomejs/biome","collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restricted