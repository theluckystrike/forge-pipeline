y":null,"stats":{"__ref":"TierStatsType:63757"},"contributors({\"limit\":4})":[{"__ref":"Contributor:464135"},{"__ref":"Contributor:729485"},{"__ref":"Contributor:1032733"},{"__ref":"Contributor:1032696"}]},"ContributorsStats:64588":{"__typename":"ContributorsStats","id":"64588","all":2,"users":0,"organizations":2},"TierStatsType:64588":{"__typename":"TierStatsType","id":64588,"availableQuantity":2147483647,"totalDonated":2000000,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:64588"}},"Tier:{\"id\":64588}":{"__typename":"Tier","id":64588,"name":"Silver sponsor ","slug":"silver-sponsor","description":"You'll be featured in the README of our repository, with a medium image.","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":50000,"minimumAmount":50000,"button":"Become a sponsor","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:64588"},"contributors({\"limit\":4})":[{"__ref":"Contributor:794841"},{"__ref":"Contributor:822928"}]},"ContributorsStats:64589":{"__typename":"ContributorsStats","id":"64589","all":1,"users":0,"organizations":1},"TierStatsType:64589":{"__typename":"TierStatsType","id":64589,"availableQuantity":2147483647,"totalDonated":895570,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:64589"}},"Tier:{\"id\":64589}":{"__typename":"Tier","id":64589,"name":"Gold sponsor ","slug":"gold-sponsor","description":"You'll be featured in the README of our repository, with a medim image. You will be featured in the homepage of the website.","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":100000,"minimumAmount":100000,"button":"Become a sponsor","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:64589"},"contributors({\"limit\":4})":[{"__ref":"Contributor:464135"}]},"ContributorsStats:64590":{"__typename":"ContributorsStats","id":"64590","all":0,"users":0,"organizations":0},"TierStatsType:64590":{"__typename":"TierStatsType","id":64590,"availableQuantity":2147483647,"totalDonated":0,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:64590"}},"Tier:{\"id\":64590}":{"__typename":"Tier","id":64590,"name":"Platinum sponsor ","slug":"platinum-sponsor","description":"You'll be featured in the README of our repository with a big image. You'll be featured on the homepage of the website.and every other page.","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":500000,"minimumAmount":500000,"button":"Become a sponsor","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:64590"},"contributors({\"limit\":4})":[]},"Member:473453":{"__typename":"Member","id":473453},"Member:473877":{"__typename":"Member","id":473877},"Member:539809":{"__typename":"Member","id":539809},"Member:636620":{"__typename":"Member","id":636620},"PlanType:693207":{"__typename":"PlanType","id":693207,"hostedCollectives":0},"Collective:693207":{"__typename":"Collective","id":693207,"idV2":"3z8arxve-ymko60vv-w5bqgl5n-bj9w704d","slug":"biome","path":"/biome","name":"Biome","hasHosting":false,"description":"Collect funds from the community, and distributes these funds to the contributors of the project.","longDescription":"\u003cdiv\u003eBiome is a toolchain for web projects; it aims to provide fast tools to maintain the said projects' healthy\u003cbr /\u003e\u003cbr /\u003eBiome provides and owns all its tools: parser, formatter, analyzer, etc.\u003cbr /\u003e\u003cbr /\u003eBiome is fast and reliable, it provides high-quality diagnostics, and it has its own LSP server out of the box. \u003cbr /\u003e\u003cbr /\u003eUsers can customise all the tools Biome provides with one configuration file.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cblockquote\u003e\u003cstrong\u003eDisclaimer:\u003c/strong\u003e \u003cem\u003e“All contributions are donations. No goods or services are expected in return. Any requests for refunds for those purposes will be rejected.” \u003c/em\u003e\u003c/blockquote\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/account-banner/2cf5afca-845a-4b82-a33d-dc919313ecf1/slogan-light-transparent-x1.png","backgroundImageUrl":"https://images.opencollective.com/biome/e669640/background.png","twitterHandle":null,"repositoryUrl":"https://github.com/biomejs","website":"https://biomejs.dev/","socialLinks":[{"__typename":"SocialLink","type":"DISCORD","url":"https://discord.gg/BypW39g6Yc"},{"__typename":"SocialLink","type":"WEBSITE","url":"https://biomejs.dev/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/biomejs"}],"location":null,"tags":["linter","formatter","open source","javascript","typescript","toolchain"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Mon Aug 28 2023 08:51:06 GMT+0000 (Coordinated Universal Time)","settings":{"features":{"conversations":true},"githubRepo":"biomejs/biome","collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":true},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true}]},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true}]},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","isEnabled":true}]},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"conversations","type":"SECTI