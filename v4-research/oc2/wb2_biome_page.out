":"Contributor:1032733"},{"__ref":"Contributor:707053"},{"__ref":"Contributor:557116"},{"__ref":"Contributor:12866"},{"__ref":"Contributor:13483"},{"__ref":"Contributor:804080"},{"__ref":"Contributor:694662"},{"__ref":"Contributor:1278653"},{"__ref":"Contributor:519537"},{"__ref":"Contributor:763334"},{"__ref":"Contributor:146275"},{"__ref":"Contributor:831577"},{"__ref":"Contributor:4987"},{"__ref":"Contributor:596979"},{"__ref":"Contributor:1032696"},{"__ref":"Contributor:472529"},{"__ref":"Contributor:476831"},{"__ref":"Contributor:805141"},{"__ref":"Contributor:789267"},{"__ref":"Contributor:567215"},{"__ref":"Contributor:786913"},{"__ref":"Contributor:735547"},{"__ref":"Contributor:834250"},{"__ref":"Contributor:933117"},{"__ref":"Contributor:1059709"},{"__ref":"Contributor:776078"},{"__ref":"Contributor:1044916"},{"__ref":"Contributor:606649"}],"tiers":[{"__ref":"Tier:{\"id\":63756}"},{"__ref":"Tier:{\"id\":65493}"},{"__ref":"Tier:{\"id\":65494}"},{"__ref":"Tier:{\"id\":63757}"},{"__ref":"Tier:{\"id\":64588}"},{"__ref":"Tier:{\"id\":64589}"},{"__ref":"Tier:{\"id\":64590}"}],"events({\"includeInactive\":true,\"includePastEvents\":true})":[],"projects":[],"members({\"role\":\"ADMIN\"})":[{"__ref":"Member:473453"},{"__ref":"Member:473877"},{"__ref":"Member:539809"},{"__ref":"Member:636620"}],"members({\"role\":\"CONNECTED_COLLECTIVE\"})":[],"plan":{"__ref":"PlanType:693207"}},"ROOT_QUERY":{"__typename":"Query","Collective({\"slug\":\"biome\",\"throwIfMissing\":false})":{"__ref":"Collective:693207"},"transactions({\"account\":{\"slug\":\"biome\"},\"host\":{\"slug\":\"opensource\"},\"includeChildrenTransactions\":true,\"includeEditedReversedTransactions\":false,\"includeGiftCardTransactions\":true,\"includeIncognitoTransactions\":true,\"kind\":[\"ADDED_FUNDS\",\"BALANCE_TRANSFER\",\"CONTRIBUTION\",\"EXPENSE\",\"PLATFORM_TIP\"],\"limit\":3})":{"__typename":"TransactionCollection","offset":0,"limit":3,"nodes":[{"__ref":"Credit:a82e1576-80f0-4009-9fda-d979264a9657"},{"__ref":"Credit:066c770d-9744-4b45-910e-2d2f6e606da9"},{"__ref":"Credit:8a106036-2ced-4134-b083-4d31a7a98f6b"}]},"expenses({\"account\":{\"slug\":\"biome\"},\"includeChildrenExpenses\":true,\"limit\":3})":{"__typename":"ExpenseCollection","totalCount":63,"nodes":[{"__ref":"Expense:ex_PWRVUfxSgHUhT3UzS0V5c"},{"__ref":"Expense:ex_xXHB2CWsPLRXyfnszfIor"},{"__ref":"Expense:ex_mR2LY4u1uIBsxD90MoblL"}]},"account({\"slug\":\"biome\"})":{"__ref":"Collective:3z8arxve-ymko60vv-w5bqgl5n-bj9w704d"}},"Host:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"Host","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k","name":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","isTrustedHost":true,"isFirstPartyHost":true,"isVerified":false,"hasPublicProfile":true,"accountingCategories":{"__typename":"AccountingCategoryCollection","nodes":[{"__ref":"AccountingCategory:xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj"},{"__ref":"AccountingCategory:703k0exg-znm8yj64-n9q5wao9-r7b4dlvr"},{"__ref":"AccountingCategory:xggnxdwz-j3le5mpw-nvpy8rvb-ko04a97b"},{"__ref":"AccountingCategory:dlk9mbw7-y48r3zq3-nd60ej5l-avnodgx7"},{"__ref":"AccountingCategory:ynmlo94z-n7x08dpo-03pewga3-vjbrky5m"},{"__ref":"AccountingCategory:78a47byg-9nxozdp8-xb6mjlv0-3rek5w8k"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-ybq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-jmq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-kw6y870m-gkbrvdn8"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-xeqy870m-gkbrvdn8"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-xkpmj9no-8agdbe57"},{"__ref":"AccountingCategory:m5ax8emk-7lnw54q7-axqgyvj0-o93zdrbn"},{"__ref":"AccountingCategory:y7mywxoz-3409rl6k-kb6venbd-j7gk85ag"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-emqmj9no-8agdbe57"},{"__ref":"AccountingCategory:388rzown-xl9e50px-xbpymvbd-gk7j43a9"},{"__ref":"AccountingCategory:388rzown-xl9e50px-n3qymvbd-gk7j43a9"},{"__ref":"AccountingCategory:acat_ISbfB99gPLtNKJDmzGijM"}]},"legacyId":11004,"legalName":"Open Source Collective","currency":"USD","isHost":true,"expensePolicy":"\u003cdiv\u003e\u003cstrong\u003eFile an invoice only when you are requesting payment for services you personally performed.\u003c/strong\u003e We can only pay the individual who completed the work -- no third parties or friends. The person who performed the work must be the owner of the account receiving payment.\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eWe have \u003cstrong\u003estrict requirements\u003c/strong\u003e for what we can and cannot process. Certain information is \u003cstrong\u003erequired\u003c/strong\u003e on all invoices, and we cannot process payment if required information is missing.\u0026nbsp;\u003c/div\u003e\u003cdiv\u003ePlease review our full policies before submitting:\u003cbr\u003e\u003ca href=\"https://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\"\u003ehttps://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\u003c/a\u003e\u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eIf your expense is missing required information or documentation, you will be asked to revise it before processing can begin. \u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003e\u003cstrong\u003eProcessing and Payment:\u0026nbsp;\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eExpenses are processed \u003cstrong\u003etwice weekly\u003c/strong\u003e after approval by a Collective administrator and a secondary OSC review\u003c/li\u003e\u003cli\u003ePayments are made via \u003cstrong\u003ePayPal or Wise (bank transfer)\u003c/strong\u003e\u003c/li\u003e\u003cli\u003ePayments are limited to countries supported by these providers\u003c/li\u003e\u003cli\u003eIf you use PayPal, you may be required to complete a \u003cstrong\u003eKYC\u003c/strong\u003e process\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003eAn uploaded invoice is \u003cstrong\u003enot required\u003c/strong\u003e -- the information entered in the expense form is sufficient.\u003cbr\u003e If you choose to upload an invoice, address it to:\u003cbr\u003e \u003cbr\u003e\u003cstrong\u003eCollective/Project Name, Open Source Collective\u003c/strong\u003e\u003cbr\u003e 440 N. Barranca Avenue #3939\u003cbr\u003e Covina, CA 91723, USA\u003c/div\u003e","website":"https://oscollective.org/","settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/for-donors-companies-organizations-and-individuals/refund-requests#refund-requests","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eVirtual cards are debit card numbers that can be issued to OSC's hosted initiatives for paying online for things like: recurring payments, online resources/tools, subscriptions, etc. They are directly tied to collectives' budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003eHow it works:\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/monthly)\u003c/strong\u003e. We will review your request and reply with any questions.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, the project must have a budget on their Open Collective account that exceeds the corresponding amount and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eRequirements/Policy:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e\u003c/li\u003e\u003cli\u003eIf a card has not been used for more than 15 months, the card will be frozen\u003c/li\u003e\u003cli\u003eIf no receipt has been uploaded to an expense after 30 days, the card will be frozen\u003c/li\u003e\u003cli\u003e​Admins are personally liable for misuse\u0026nbsp;\u003c/li\u003e\u003cli\u003eThe assigned card admin must complete a W-9 (for US-based admins) or a W-8BEN (for non-US admins) tax form before approval.\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eLimitations:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cbr\u003eIf you need to input Cardholder contact details/address:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003eSteps to set up the card that need to be performed by the collective admin:\u003c/div\u003e\u003cul\u003e\u003cli\u003eLog in to the Open Collective platform. In the left navigation, click on Virtual Cards -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003ch3\u003e​After a purchase is made:\u003c/h3\u003e\u003cdiv\u003eThe funds will be withdrawn from your initiative\u003c/div\u003e\u003cul\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt\u0026nbsp;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eIf the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":true,"autopauseUnusedCards":{"period":455,"enabled":true}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurrin