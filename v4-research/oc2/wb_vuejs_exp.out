:\"ACCOUNT\"})":{"__typename":"Amount","valueInCents":700000,"currency":"USD","exchangeRate":null},"amountV2({\"currencySource\":\"HOST\"})":{"__typename":"Amount","valueInCents":700000,"currency":"USD","exchangeRate":null},"currency":"USD","type":"INVOICE","requiredLegalDocuments":null,"feesPayer":"COLLECTIVE","account":{"__ref":"Collective:nmlo94zn-7x08dpob-awqewga3-vjbrky5m"},"permissions":{"__ref":"ExpensePermissions:rmvrwng4-kj03dpbw-drxpz57o-yl9e8xba"},"payoutMethod":{"__ref":"PayoutMethod:0n4gx0br-ov5m96n0-oyyqd8lk-3ey7jzwa"},"payee":{"__ref":"Individual:vedj9wro-z3a56d3d-v7zp7blg-8x4m0ykn"},"createdByAccount":{"__ref":"Individual:vedj9wro-z3a56d3d-v7zp7blg-8x4m0ykn"}},"ROOT_QUERY":{"__typename":"Query","account({\"slug\":\"vuejs\"})":{"__ref":"Collective:nmlo94zn-7x08dpob-awqewga3-vjbrky5m"},"expenses({\"account\":{\"slug\":\"vuejs\"},\"limit\":10,\"offset\":0,\"orderBy\":{\"direction\":\"DESC\",\"field\":\"CREATED_AT\"}})":{"__typename":"ExpenseCollection","totalCount":222,"offset":0,"limit":10,"nodes":[{"__ref":"Expense:re0adkjr-v8xwm69r-kzo67z5n-4l93bgoy"},{"__ref":"Expense:k3z8arxv-eymko60m-gw8qgl5n-bj9w704d"},{"__ref":"Expense:eeng0kzd-yvor4pzj-8drqbma8-37xlw95j"},{"__ref":"Expense:lk9mbw7y-48r3zq3y-ognp0ej5-lavnodgx"},{"__ref":"Expense:rvedj9wr-oz3a56dz-j0oq7blg-8x4m0ykn"},{"__ref":"Expense:nmlo94zn-7x08dpo4-vdw6ewga-3vjbrky5"},{"__ref":"Expense:rvedj9wr-oz3a56dz-dygq7blg-8x4m0ykn"},{"__ref":"Expense:03k0exgz-nm8yj640-al7p5wao-9r7b4dlv"},{"__ref":"Expense:8a47byg9-nxozdp8n-4wbpmjlv-03rek5w8"},{"__ref":"Expense:rmvrwng4-kj03dpbw-drxpz57o-yl9e8xba"}]},"expenses({\"host\":{\"slug\":\"vuejs\"},\"limit\":1,\"payoutMethodType\":\"BANK_ACCOUNT\",\"status\":\"SCHEDULED_FOR_PAYMENT\"})":{"__typename":"ExpenseCollection","totalCount":0}}},"__APOLLO_VARIABLES__":{"account":{"slug":"vuejs"},"limit":10,"offset":0,"sort":{"field":"CREATED_AT","direction":"DESC"},"direction":"RECEIVED","accountSlug":"vuejs"},"__APOLLO_ERROR__":null,"__APOLLO_QUERY_DATA__":{"account":{"__typename":"Collective","id":"nmlo94zn-7x08dpob-awqewga3-vjbrky5m","legacyId":903,"slug":"vuejs","type":"COLLECTIVE","imageUrl":"https://images.opencollective.com/vuejs/5447764/logo.png","backgroundImageUrl":null,"twitterHandle":"vuejs","name":"vue","currency":"USD","isArchived":false,"isActive":true,"settings":{"editor":"markdown","githubRepo":"vuejs/vue"},"createdAt":"2017-09-09T18:23:53.988Z","supportedExpenseTypes":["INVOICE","RECEIPT"],"expensesTags":[{"__typename":"TagStat","id":"engineering","tag":"engineering"},{"__typename":"TagStat","id":"travel","tag":"travel"},{"__typename":"TagStat","id":"communications","tag":"communications"},{"__typename":"TagStat","id":"office","tag":"office"},{"__typename":"TagStat","id":"supplies \u0026 materials","tag":"supplies \u0026 materials"},{"__typename":"TagStat","id":"web services","tag":"web services"},{"__typename":"TagStat","id":"team","tag":"team"},{"__typename":"TagStat","id":"food \u0026 beverage","tag":"food \u0026 beverage"},{"__typename":"TagStat","id":"donation","tag":"donation"}],"features":{"__typename":"CollectiveFeatures","id":"nmlo94zn-7x08dpob-awqewga3-vjbrky5m","ABOUT":"ACTIVE","CONNECTED_ACCOUNTS":"AVAILABLE","RECEIVE_FINANCIAL_CONTRIBUTIONS":"ACTIVE","RECURRING_CONTRIBUTIONS":"AVAILABLE","EVENTS":"AVAILABLE","PROJECTS":"AVAILABLE","USE_EXPENSES":"ACTIVE","RECEIVE_EXPENSES":"ACTIVE","COLLECTIVE_GOALS":"DISABLED","TOP_FINANCIAL_CONTRIBUTORS":"ACTIVE","CONVERSATIONS":"AVAILABLE","UPDATES":"AVAILABLE","TEAM":"ACTIVE","CONTACT_FORM":"ACTIVE","RECEIVE_HOST_APPLICATIONS":"UNSUPPORTED","HOST_DASHBOARD":"UNSUPPORTED","TRANSACTIONS":"ACTIVE","REQUEST_VIRTUAL_CARDS":"DISABLED"},"stats":{"__typename":"AccountStats","id":"nmlo94zn-7x08dpob-awqewga3-vjbrky5m","balanceWithBlockedFunds":{"__typename":"Amount","valueInCents":2722515,"currency":"USD"}},"isApproved":true,"host":{"__typename":"Host","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k","legacyId":11004,"name":"Open Source Collective","legalName":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","currency":"USD","isHost":true,"expensePolicy":"\u003cdiv\u003e\u003cbr /\u003eWe process expenses twice a week after an admin of the Collective has approved them. We make payments via PayPal and Bank Transfer (using Wise) and can only make payouts to countries served by these payment processors. You are not required to upload an invoice document (the data you submit in the expense form is sufficient), but if you would like to include an uploaded invoice, please make it out to: \u003cbr /\u003e\u003cem\u003eCollective Name\u003c/em\u003e, Open Source Collective, \u003cem\u003e440 N. Barranca Avenue #3939, Covina, CA 91723, USA\u003cbr /\u003e\u003cbr /\u003e\u003c/em\u003e\u003cstrong\u003eINFORMATION REQUIRED ON EXPENSES:\u003c/strong\u003e\u003cem\u003e\u003cbr /\u003e\u003c/em\u003ePlease refer to the \u003ca href=\"https://docs.oscollective.org/how-it-works/basics/invoice-and-reimbursement-examples\"\u003edocumentation here\u003c/a\u003e for payment processing requirements on reimbursements and invoices.\u003cbr /\u003e\u003cbr /\u003e\u003cstrong\u003eREFUNDS:\u003c/strong\u003e\u003cbr /\u003eIf you would like a refund, please email hello@oscollective.org with the transaction #, the collective you donated to, the date, and the amount of the transaction.\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e","website":"https://oscollective.org/","settings":{"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/faq/expenses#can-i-refund-a-donation-or-get-a-refund-for-one-i-have-made","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eVirtual cards are debit card numbers that can be issued to OSC's hosted initiatives for paying online for things like: recurring payments, utility bills, online resources/tools, subscriptions, vendors (e.g. wholesale distributors), etc. They are directly tied to collectives' budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003eHow it works:\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/monthly)\u003c/strong\u003e. The virtual card with that limit will be set up for your collective.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, initiative must have a budget on their Open Collective account that exceeds the corresponding amount, and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eRequirements/Policy:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eInitiatives must have a minimum of 2 admin members\u003c/li\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e​\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eLimitations:\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eIf you need to input Cardholder contact details/address:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003eSteps:\u003c/div\u003e\u003ch3\u003eSetup the card:\u003cbr\u003eInitiative admins request the card from OSC:\u003c/h3\u003e\u003cul\u003e\u003cli\u003eVisit your initiative's page\u003c/li\u003e\u003cli\u003eClick Actions -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003c/div\u003e\u003ch3\u003e​After a purchase is made:\u003c/h3\u003e\u003cdiv\u003eThe funds will be withdrawn from your initiative\u003c/div\u003e\u003cul\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt. \u003cstrong\u003e(If the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt)\u003c/strong\u003e.\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":false,"autopauseUnusedCards":{"period":90,"enabled":false}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"restrictedTo":[]},{"section":"budget","isEnabled":true,"restrictedTo":[]}]},"hostCollective":{"id":11004},"paymentMethods":{"manual":{"title":"Bank Transfer (manual)","features":{"recurring":false},"instructions":"If you need an Invoice, please contact us at hello@oscollective.org\n\n-------------------------------------\n\nPlease note that the instructions for transfers differ for sending USD and non-USD currencies. \n\n** For USD transfers (from US-based or non-US-based banks) **\nMake sure to include the reference number in the memo field.\n\nAmount: {amount}\nReference: {reference}\n\nIBAN / Account Number: 202525828483\nABA / Routing: 091311229\nSWIFT: CHFGUS44021\n\nAccount type: Business Checking\nBank name: Choice Financial Group\nBank address: 4501 23rd Avenue S, Fargo, ND 58104, USA\n\nAccount name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\n** For any non-USD transfers (e.g. EUR, GBP, CAD, INR...) **\n\nImportant: you are required to include the information below in the “Memo” or reference field. If you run out of space, include as much as you can.\n/FFC/202525828483/Open Source Collective/Covina, USA, {reference}\n\nAmount: {amount}\n\nSWIFT / 