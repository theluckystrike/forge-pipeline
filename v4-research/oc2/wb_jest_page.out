cstrong\u003eInstant Feedback\u003c/strong\u003e\u003c/h3\u003e\u003cdiv\u003eFast interactive watch mode runs only test files related to changed files and is optimized to give signal quickly.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003ch3\u003e📸 \u003cstrong\u003eSnapshot Testing\u003c/strong\u003e\u003c/h3\u003e\u003cdiv\u003eCapture snapshots of React trees or other serializable values to simplify testing and to analyze how state changes over time.\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003eNotes: We don't respond to requests about adding or changing links through OpenCollective, and all sponsor links have nofollow enabled. This means no SEO advantages from the links.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/e02706d0-ea1c-11eb-9107-bfe67623347c.png","backgroundImageUrl":"https://images.opencollective.com/jest/92d0657/background.png","twitterHandle":"jestjs_","repositoryUrl":null,"website":"https://jestjs.io/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://jestjs.io/"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/jestjs_"}],"location":{"__ref":"LocationType:35612"},"tags":["open source","framework","testing","javascript"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Mon May 21 2018 16:36:25 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{}],"editor":"html","features":{"rejectContribution":true},"githubRepo":"facebook/jest","moderation":{"rejectedCategories":["ADULT","AFFILIATE_REVIEW","CASINO_GAMBLING","SEO_AUDIENCE","VPN_PROXY","WRITER","FINANCE_INSURANCE","PHARMACY"]},"collectivePage":{"background":{"crop":{"x":362,"y":-58},"zoom":1,"mediaSize":{"width":1441,"height":483},"isAlignedRight":true},"tiersOrder":[4574,4573,"custom"],"primaryColor":"#BE2721"},"disablePublicExpenseSubmission":false},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":fals