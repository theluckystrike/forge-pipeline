s="StyledIconBase-sc-ea9ulj-0 cyQuJj"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="16" y2="12"></line><line x1="12" x2="12.01" y1="8" y2="8"></line></svg></div></div><hr class="sc-d0d050d8-0 hGzNES"/></div><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 frKAFo wSTCA"><p color="black.700" class="sc-dcb94ee2-0 sc-b1a93422-3 byZndi fmgVAn">Let’s get the ball rolling!</p></div></div><section id="section-updates" data-cy="section-updates" class="sc-3340244f-0 iTPjmR"><div class="sc-9ed2d16a-0 sc-7355880b-0 czvsjw"><h2 font-size="20px,24px,32px" color="black.700" font-weight="normal" class="sc-1709896-0 NVTKe">News from Jest</h2><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 iVvBqZ hvfLzF"><p color="black.700" class="sc-dcb94ee2-0 sc-7234a878-1 eEeoYU blMYZB">Updates on our activities and progress.</p></div><div class="sc-d3b1f0c-0 hncGsq"><div class="sc-2c35d607-0 fURMss"><div class="sc-9ed2d16a-0 bKpiA-d"><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 jzMvMa csvMWi"><div class="sc-d3b1f0c-0 qIesT"><a title="Rick Hanlon" class="hover:underline" href="/rickhanlonii"><div style="background-image:url(https://images.opencollective.com/rickhanlonii/3f738db/avatar.png?height=80);background-size:cover" size="40" type="INDIVIDUAL" src="https://images.opencollective.com/rickhanlonii/3f738db/avatar.png?height=80" title="Rick Hanlon" class="sc-d3b1f0c-0 sc-d3b1f0c-1 jFejKr fGEJMP sc-ff045f41-0 fEQhME"></div></a></div><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 giVqMW eDZLcq"><a href="/jest/updates/removing-links-from-homepage"><p color="black.900" font-weight="600" class="sc-dcb94ee2-0 hAeQmn">Removing Links from Homepage</p></a><div class="sc-9ed2d16a-0 dgVncz"><div><div style="display:inline" font-size="14px" class="sc-63bf996f-0 bKpumw sc-63bf996f-2 janBkL">Hey Backers! Heads up: we&#x27;ve made the decision to remove backer links from the Jest homepage. While we want to recognize everyone who contributes to Jest and makes continued development of Jest possible, unfortunately the overwhelming major...</div></div> <a class="sc-7169fd69-0 jrfJjM" font-size="12px" color="primary.500" href="/jest/updates/removing-links-from-homepage">Read more</a></div><div color="black.600" font-size="12px" class="sc-9ed2d16a-0 ccmCzU">Published on January 15, 2024 by <a title="Rick Hanlon" class="hover:underline" href="/rickhanlonii">Rick Hanlon</a></div></div></div></div></div><a href="/jest/updates"><button data-cy="view-all-updates-btn" width="1" font-size="14px" class="sc-532480db-0 fvwWQl">View all updates<!-- --> →</button></a></div></div></section><div id="category-ABOUT" class="sc-9ed2d16a-0 sc-b1a93422-0 EBMGw bxETTS"><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 fqoDra ferUGe"><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 sc-b1a93422-2 htvGag faHCM lodRtm"><img src="/static/images/collective-navigation/CollectiveNavbarIconAbout.png" alt="" class="sc-b1a93422-1 dWuXCV"/></div><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 kelEPL fHSAwH"><h2 data-cy="category-ABOUT-title" font-size="32px" font-weight="normal" color="black.900" class="sc-1709896-0 bWUsCp">About</h2></div><hr class="sc-d0d050d8-0 hGzNES"/></div></div><section id="section-about" data-cy="section-about" class="sc-3340244f-0 iTPjmR"><div class="sc-9ed2d16a-0 sc-7355880b-0 cIqaQH"><div class="sc-9ed2d16a-0 eRmECd"><div class="sc-9ed2d16a-0 jRaTqn"><div><div data-cy="longDescription" font-size="14px" class="sc-63bf996f-0 bKpumw sc-63bf996f-2 janBkL"><h3>👩🏻‍💻 <strong>Developer Ready</strong></h3><div>Complete and ready to set-up JavaScript testing solution. Works out of the box for any React project.<br/><br/></div><h3>🏃🏽 <strong>Instant Feedback</strong></h3><div>Fast interactive watch mode runs only test files related to changed files and is optimized to give signal quickly.<br/><br/></div><h3>📸 <strong>Snapshot Testing</strong></h3><div>Capture snapshots of React trees or other serializable values to simplify testing and to analyze how state changes over time.<br/><br/><br/>Notes: We don&#x27;t respond to requests about adding or changing links through OpenCollective, and all sponsor links have nofollow enabled. This means no SEO advantages from the links.<br/><br/></div></div></div></div></div></div></section><section id="section-our-team" data-cy="section-our-team" class="sc-3340244f-0 eGKBUl"><div class="sc-9ed2d16a-0 sc-7355880b-0 jyulmr"><div class="sc-9ed2d16a-0 uzGKt"><h2 font-weight="500" color="black.700" class="sc-dcb94ee2-0 sc-dcb94ee2-5 kmgLsS">Our team</h2><div class="sc-9ed2d16a-0 bGxwtX"><div width="144" height="auto" class="sc-2c35d607-0 sc-d82cae7-0 bfQJEs gMcYKv"><div class="sc-d82cae7-1 jfGyLV"><div class="sc-d3b1f0c-0 inLDtj"><a href="/cpojer"><div style="background-image:url(https://images.opencollective.com/cpojer/f9b14fe/avatar.png);background-size:cover" size="64" type="USER" src="https://images.opencollective.com/cpojer/f9b14fe/avatar.png" title="Christoph Nakazawa" class="sc-d3b1f0c-0 sc-d3b1f0c-1 kFsjOb cskNqH sc-ff045f41-0 iEGXco"></div></a></div></div><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 iJlvnw hqNDzM"><a href="/cpojer"><p color="black.900" font-weight="500" title="Christoph Nakazawa" class="sc-dcb94ee2-0 boFGUd">Christoph Nak...</p></a><div class="sc-d3b1f0c-0 gmTaiH"><div class="sc-afa001f2-0 fZtaHx sc-d82cae7-4 kJsbDm">Admin</div></div><div class="sc-d3b1f0c-0 eVvpCT"></div></div></div><div width="144" height="auto" class="sc-2c35d607-0 sc-d82cae7-0 bfQJEs gMcYKv"><div class="sc-d82cae7-1 jfGyLV"><div class="sc-d3b1f0c-0 inLDtj"><a href="/thymikee"><div style="background-image:url(https://images.opencollective.com/thymikee/b7cfaba/avatar.png);background-size:cover" size="64" type="USER" src="https://images.opencollective.com/thymikee/b7cfaba/avatar.png" title="Michał Pierzchała" class="sc-d3b1f0c-0 sc-d3b1f0c-1 kFsjOb cskNqH sc-ff045f41-0 iEGXco"></div></a></div></div><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 iJlvnw hqNDzM"><a href="/thymikee"><p color="black.900" font-weight="500" title="Michał Pierzchała" class="sc-dcb94ee2-0 boFGUd">Michał Pierzc...</p></