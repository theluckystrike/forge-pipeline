"2022-09-08T22:00:00.000Z","image":"https://images.opencollective.com/liuxingbaoyu/avatar.png","description":"","collectiveSlug":"liuxingbaoyu","totalAmountDonated":0,"type":"USER","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":544660,"hasPublicProfile":true}],"financialContributors":[{"__typename":"Contributor","id":"4087","name":"Airbnb","roles":["BACKER"],"isAdmin":false,"isCore":false,"isBacker":true,"since":"2018-04-19T17:00:00.000Z","image":"https://images.opencollective.com/airbnb/d327d66/logo.png","description":"Gold Sponsors","collectiveSlug":"airbnb","totalAmountDonated":21785800,"type":"FUND","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[355,1906,null],"collectiveId":4087,"hasPublicProfile":true},{"__typename":"Contributor","id":"973569","name":"Sovereign Tech Agency","roles":["BACKER"],"isAdmin":false,"isCore":false,"isBacker":true,"since":"2025-05-19T11:11:59.086Z","image":"https://images.opencollective.com/11004-sovereign-tech-agency-b04719f2/f91ad4d/logo.png","description":null,"collectiveSlug":"11004-sovereign-tech-agency-b04719f2","totalAmountDonated":20751135,"type":"VENDOR","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":973569,"hasPublicProfile":false},{"__typename":"Contributor","id":"164160","name":"GitHub Sponsors","roles":["BACKER"],"isAdmin":false,"isCore":false,"isBacker":true,"since":"2020-12-27T19:45:59.618Z","image":"https://images.opencollective.com/github-sponsors/dc0ae97/logo.png","description":null,"collectiveSlug":"github-sponsors","totalAmountDonated":15739248,"type":"ORGANIZATION","publicMessage":null,"isIncognito":false,"isGuest":false,"tiersIds":[null],"collectiveId":164160,"hasPublicProfile":true},{"__typename":"Contributor","id":"19490","name":"Handshake","roles":["BACKER"],"isAdmin":false,"isCore":false,"isBacker":true,"since":"2018-08-16T16:08:17.473Z","image":"https://images.opencollective.com/handshake/a795b61/logo.p