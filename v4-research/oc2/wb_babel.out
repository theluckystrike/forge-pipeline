ckers","description":"Support us with a monthly donation and help us continue our work!","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":500,"minimumAmount":200,"button":"Become a backer","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:355"},"contributors({\"limit\":4})":[{"__ref":"Contributor:4087"},{"__ref":"Contributor:16411"},{"__ref":"Contributor:112485"},{"__ref":"Contributor:44355"}]},"ContributorsStats:356":{"__typename":"ContributorsStats","id":"356","all":56,"users":20,"organizations":34},"TierStatsType:356":{"__typename":"TierStatsType","id":356,"availableQuantity":2147483647,"totalDonated":11710679,"totalRecurringDonations":10000,"contributors":{"__ref":"ContributorsStats:356"}},"Tier:{\"id\":356}":{"__typename":"Tier","id":356,"name":"Bronze Sponsors","slug":"bronze-sponsors","description":"Thanks for being a sponsor!","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":10000,"minimumAmount":10000,"button":"Become a sponsor","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:356"},"contributors({\"limit\":4})":[{"__ref":"Contributor:69553"},{"__ref":"Contributor:4409"},{"__ref":"Contributor:4536"},{"__ref":"Contributor:160377"}]},"ContributorsStats:1905":{"__typename":"ContributorsStats","id":"1905","all":50,"users":9,"organizations":41},"TierStatsType:1905":{"__typename":"TierStatsType","id":1905,"availableQuantity":2147483647,"totalDonated":30617647,"totalRecurringDonations":150000,"contributors":{"__ref":"ContributorsStats:1905"}},"Tier:{\"id\":1905}":{"__typename":"Tier","id":1905,"name":"Silver Sponsors","slug":"silver-sponsors","description":"Be a silver sponsor with a monthly donation of $500 and get your logo on babeljs.io. Note:\n\nPlease wait at least 24 hours for your company's logo and link to appear on babeljs.io. Babel reserves the right to remove links and logos from babeljs.io at its discretion, and a donation does not guarantee a logo and link will appear on babeljs.io. (added August 2020)","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":50000,"minimumAmount":50000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:1905"},"contributors({\"limit\":4})":[{"__ref":"Contributor:194260"},{"__ref":"Contributor:14898"},{"__ref":"Contributor:114241"},{"__ref":"Contributor:4536"}]},"ContributorsStats:1906":{"__typename":"ContributorsStats","id":"1906","all":9,"users":0,"organizations":4},"TierStatsType:1906":{"__typename":"TierStatsType","id":1906,"availableQuantity":2147483647,"totalDonated":42018420,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:1906"}},"Tier:{\"id\":1906}":{"__typename":"Tier","id":1906,"name":"Gold Sponsors","slug":"gold-sponsors","description":"Be a gold sponsor with a monthly donation of $1000 and get your logo (large) on babeljs.io. Note:\n\nPlease wait at least 24 hours for your company's logo and link to appear on babeljs.io.  Babel reserves the right to remove links and logos from babeljs.io at its discretion, and a donation does not guarantee a logo and link will appear on babeljs.io. (added August 2020)","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":100000,"minimumAmount":100000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:1906"},"contributors({\"limit\":4})":[{"__ref":"Contributor:4087"},{"__ref":"Contributor:19490"},{"__ref":"Contributor:16411"},{"__ref":"Contributor:2309"}]},"ContributorsStats:3790":{"__typename":"ContributorsStats","id":"3790","all":4,"users":0,"organizations":3},"TierStatsType:3790":{"__typename":"TierStatsType","id":3790,"availableQuantity":2147483647,"totalDonated":13682100,"totalRecurringDonations":0,"contributors":{"__ref":"ContributorsStats:3790"}},"Tier:{\"id\":3790}":{"__typename":"Tier","id":3790,"name":"Base Support Sponsor","slug":"base-support-sponsor","description":"Be a Base Support Sponsor with a yearly donation of \u003e$24,000 (\u003e$2k/month) and get your logo on babeljs.io, as well as access to up to 2 hours of support per month. \n\nSupport will be remote with the option of chat or screenshare. Contact Babel's core team to set up time slots and for sponsorship for other support requirements (more hours, workshops, etc).","useStandalonePage":false,"goal":null,"interval":"year","currency":"USD","amount":2400000,"minimumAmount":2400000,"button":null,"amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:3790"},"contributors({\"limit\":4})":[{"__ref":"Contributor:2309"},{"__ref":"Contributor:6060"},{"__ref":"Contributor:268661"},{"__ref":"Contributor:5610"}]},"Member:3847":{"__typename":"Member","id":3847},"Member:29768":{"__typename":"Member","id":29768},"Member:62396":{"__typename":"Member","id":62396},"Member:332306":{"__typename":"Member","id":332306},"PlanType:580":{"__typename":"PlanType","id":580,"hostedCollectives":0},"Collective:580":{"__typename":"Collective","id":580,"idV2":"dgm9bnk8-0437xqry-ejpvzeol-jdayw5re","slug":"babel","path":"/babel","name":"Babel","hasHosting":false,"description":"Babel is the community maintained compiler for evolving the future of JavaScript","longDescription":"\u003cdiv\u003e\u003cbr /\u003eYou'll be helping Babel's maintainers manage a project used by most of the world to compile their JavaScript (including most frameworks like React, Ember, Vue) with more than \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fwww.npmjs.com%2Fpackage%2F%40babel%2Fcore\"\u003e28 million downloads/week\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eThe funds are generally intended to be used to:\u003c/div\u003e\u003cul\u003e\u003cli\u003eSupport part/full-time maintainers: most core team members contribute in their spare time, and being able to focus on work would go well with less burnout and a sustainable future for the project as a whole.\u003c/li\u003e\u003cli\u003eAllow us to meet in-person as well as attend conferences and \u003ca href=\"https://github.com/tc39/agendas\"\u003eTC39 (the committee that specifies JavaScript) meetings\u003c/a\u003e which are every 2 months at various companies around the world. This allows us to be involved in the process that moves various JavaScript proposals forward, allowing us to understand and take part in that discussion and be an implementer (similar to other browsers).\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003eBabel helps you write the latest version of JavaScript, and is helping shape the future of the language itself. It's used at Facebook, Google, Netflix, and \u003ca href=\"https://opencollective.com/redirect?url=http%3A%2F%2Fbabeljs.io%2Fusers\"\u003ehundreds of other companies\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eWhen your target browsers (Chrome, Firefox, Safari, IE) don't support certain features natively, it helps you compile it down to a supported version.\u003c/div\u003e\u003cdiv\u003e\u003cbr /\u003eIn short, developers want to take advantage of the latest syntax in JavaScript before it's implemented in browsers, now. Because the version of JavaScript depends on the client's browser, we can't rely on the fact they are using an up to date browser.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e\u003cdiv\u003eBabel abstracts the browser away so that you can worry about writing your application rather than trying to figure out what features are supported in each one.\u003cbr /\u003e\u003cbr /\u003e\u003c/div\u003e","backgroundImage":"https://cl.ly/3A1a2M0F430p/babel-compressed.jpg","backgroundImageUrl":"https://images.opencollective.com/babel/9a38a01/background.jpg","twitterHandle":"babeljs","repositoryUrl":"https://github.com/babel","website":"https://babeljs.io","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://babeljs.io"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/babeljs"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/babel"}],"location":{"__ref":"LocationType:48715"},"tags":["javascript","es6","es2015","babel","compiler","open source"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Sat Apr 01 2017 14:02:10 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{"key":"8d8bddbd-a9e0-472a-a9c4-0c1786f927ab","type":"yearlyBudget","title":"3 maintainers","amount":33333300,"description":"The goal is to pay Henry, Jùnliàng and Nicolò a salary as maintainers."}],"editor":"html","features":{"recurringExpenses":true},"githubOrg":"babel","moderation":{"rejectedCategories":[]},"collectivePage":{"sections":[{"name":"goals","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true},{"name":"events","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"connected-collectives","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","isEnabled":true}]},{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"recurring-contributions","type":"SECTION","isEnabled":true}]},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]}]},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":false,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":[]}]},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true},{"name":"our-team","type":"SECTION","isEnabled":true}]}],"showGoa