":false,"description":"Prettier is an opinionated code formatter.","longDescription":"\u003cp\u003ePrettier is an opinionated code formatter. It enforces a consistent style by parsing your code and re-printing it with its own rules that take the maximum line length into account, wrapping code when necessary.\u003c/p\u003e\n\u003cp\u003ePrettier can be run in your editor on-save, in a pre-commit hook, or in CI environments to ensure your codebase has a consistent style without devs ever having to post a nit-picky comment on a code review ever again!\u003c/p\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/2ab8aa00-7d7d-11e9-b01a-d5fb1041ac09.png","backgroundImageUrl":"https://images.opencollective.com/prettier/7242acc/background.png","twitterHandle":"PrettierCode","repositoryUrl":"https://github.com/prettier","website":"https://prettier.io","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://prettier.io"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/PrettierCode"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/prettier"}],"location":null,"tags":["open source","pledged","javascript","prettier"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Thu Mar 07 2019 07:54:51 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{}],"editor":"html"},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":10,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://opencollective-production.s3.us-west-1.amazonaws.com/f4a19e40-7d7c-11e9-b01a-d5fb1041ac09.png","imageUrl({\"height\":256})":"https://images.opencollective.com/prettier/4247d7e/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["INVOICE","RECEIPT"],"features":{"__ref":"CollectiveFeatu