px" height="12px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-expand" aria-hidden="true"><path d="m15 15 6 6"></path><path d="m15 9 6-6"></path><path d="M21 16v5h-5"></path><path d="M21 8V3h-5"></path><path d="M3 16v5h5"></path><path d="m3 21 6-6"></path><path d="M3 8V3h5"></path><path d="M9 9 3 3"></path></svg>Total disbursed</div><p color="black.700" class="sc-dcb94ee2-0 dyiNgH"><span class="whitespace-nowrap font-bold">$674,160.48</span> <span>USD</span></p></div><div data-cy="budgetSection-estimated-budget" class="sc-25adca4-1 tcotN"><div color="black.700" class="sc-9ed2d16a-0 sc-25adca4-0 jUHlMG fqzFzl"><svg viewBox="0 0 24 24" height="12px" width="12px" aria-hidden="true" focusable="false" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="StyledIconBase-sc-ea9ulj-0 cyQuJj"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg><span color="black.700" data-state="closed" type="button" class="sc-ff69f675-0 lDXNF">Estimated annual budget</span></div><p color="black.700" class="sc-dcb94ee2-0 dyiNgH"><span class="whitespace-nowrap font-bold">$420,065.56</span> <span>USD</span></p></div></div></div></div></section><div id="category-ABOUT" class="sc-9ed2d16a-0 sc-b1a93422-0 EBMGw bxETTS"><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 fqoDra ferUGe"><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 sc-b1a93422-2 htvGag faHCM ffbNMd"><img src="/static/images/collective-navigation/CollectiveNavbarIconAbout.png" alt="" class="sc-b1a93422-1 dWuXCV"/></div><div class="sc-d3b1f0c-0 sc-d3b1f0c-1 kelEPL fHSAwH"><h2 data-cy="category-ABOUT-title" font-size="32px" font-weight="normal" color="black.900" class="sc-1709896-0 bWUsCp">About</h2></div><hr class="sc-d0d050d8-0 hGzNES"/></div></div><section id="section-about" data-cy="section-about" class="sc-3340244f-0 iTPjmR"><div class="sc-9ed2d16a-0 sc-7355880b-0 cIqaQH"><div class="sc-9ed2d16a-0 eRmECd"><div class="sc-9ed2d16a-0 jRaTqn"><div><div data-cy="longDescription" font-size="14px" class="sc-63bf996f-0 bKpumw sc-63bf996f-2 cBCMaS"><div><a href="https://opencollective.com/redirect?url=https%3A%2F%2Fastro.build%2F">Astro</a> is an MIT licensed open source project and completely free to use.<br/><br/>Trusted by Google, Microsoft, Cloudflare, OpenAI and more, Astro is the web framework for building content-driven websites like blogs, marketing, and e-commerce.<br/><br/>Your financial contributions <a href="https://opencollective.com/redirect?url=https%3A%2F%2Fastro.build%2Fblog%2Fsupporting-the-future-of-astro%2F">support the community behind the open source project</a> for ongoing maintenance and development.<br/><br/>Thanks to our partners and sponsorships, we have been able to disperse more than $500,000 in open source sponsorships to Astro’s community contributors, which include more than half of Astro’s core maintainers working on several key areas of the project.<br/><br/>Please visit our website for even more ways to <a href="https://opencollective.com/redirect?url=https%3A%2F%2Fastro.build%2Fpartnerships%2F">partner with Astro</a>.<br/><br/>Disclaimer: We may recognize some levels of sponsorship with a logo and/or link on Astro sites such as our marketing homepage, GitHub README, and docs website. However, all contributions are donations. No goods or services are expected in return. Any requests for refunds for those purposes will be rejected.</div></div></div></div></div></div></section><section id="section-our-team" data-cy="section-our-team" class="sc-3340244f-0 eGKBUl"><div class="sc-9ed2d16a-0 sc-7355880b-0 jyulmr"><div class="sc-9ed2d16a-0 uzGKt"><h2 font-weight="500" color="black.700" class="sc-dcb94ee2-0 sc-dcb94ee2-5 kmgLsS">Our team</h2><div class="sc-9ed2d16a-0 bGxwtX"><div width="144" h