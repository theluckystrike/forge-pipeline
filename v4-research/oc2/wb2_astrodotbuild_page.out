,"id":31735,"availableQuantity":2147483647,"totalDonated":40062890,"totalRecurringDonations":1250000,"contributors":{"__ref":"ContributorsStats:31735"}},"Tier:{\"id\":31735}":{"__typename":"Tier","id":31735,"name":"Exclusive Sponsor","slug":"exclusive-sponsor","description":"Contact us for more details on an exclusive sponsorship for your company. We are happy to work with you to create a custom partnership just for you. Email partner@astro.build to get in touch!","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":1000000,"minimumAmount":1000000,"button":"Sponsor","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:31735"},"contributors({\"limit\":4})":[{"__ref":"Contributor:554607"},{"__ref":"Contributor:6767"}]},"Member:217610":{"__typename":"Member","id":217610},"Member:652490":{"__typename":"Member","id":652490},"Member:867291":{"__typename":"Member","id":867291},"PlanType:422209":{"__typename":"PlanType","id":422209,"hostedCollectives":0},"Collective:422209":{"__typename":"Collective","id":422209,"idV2":"8k03reyd-5agmq5en-g4eqlbwo-z7j4nxv9","slug":"astrodotbuild","path":"/astrodotbuild","name":"Astro","hasHosting":false,"description":"Join Astro and Starlight on the mission to make websites fast, lightweight, accessible, and eco-friendly! Build the web you want. Support the framework that gets you there!","longDescription":"\u003cdiv\u003e\u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fastro.build%2F\"\u003eAstro\u003c/a\u003e is an MIT licensed open source project and completely free to use.\u003cbr /\u003e\u003cbr /\u003eTrusted by Google, Microsoft, Cloudflare, OpenAI and more, Astro is the web framework for building content-driven websites like blogs, marketing, and e-commerce.\u003cbr /\u003e\u003cbr /\u003eYour financial contributions \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fastro.build%2Fblog%2Fsupporting-the-future-of-astro%2F\"\u003esupport the community behind the open source project\u003c/a\u003e for ongoing maintenance and development.\u003cbr /\u003e\u003cbr /\u003eThanks to our partners and sponsorships, we have been able to disperse more than $500,000 in open source sponsorships to Astro’s community contributors, which include more than half of Astro’s core maintainers working on several key areas of the project.\u003cbr /\u003e\u003cbr /\u003ePlease visit our website for even more ways to \u003ca href=\"https://opencollective.com/redirect?url=https%3A%2F%2Fastro.build%2Fpartnerships%2F\"\u003epartner with Astro\u003c/a\u003e.\u003cbr /\u003e\u003cbr /\u003eDisclaimer: We may recognize some levels of sponsorship with a logo and/or link on Astro sites such as our marketing homepage, GitHub README, and docs website. However, all contributions are donations. No goods or services are expected in return. Any requests for refunds for those purposes will be rejected.\u003c/div\u003e","backgroundImage":"https://opencollective-production.s3.us-west-1.amazonaws.com/account-banner/fd2f21fd-cb28-4f51-b73f-0150ee9212ab/Cover_-_Open_Collective_1.webp","backgroundImageUrl":"https://images.opencollective.com/astrodotbuild/3697eff/background.png","twitterHandle":"astrodotbuild","repositoryUrl":"https://github.com/withastro/astro","website":"https://astro.build/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://astro.build/"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/withastro/astro"},{"__typename":"SocialLink","type":"DISCORD","url":"https://astro.build/chat/"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/astrodotbuild"},{"__typename":"SocialLink","type":"BLUESKY","url":"https://bsky.app/profile/astro.build"},{"__typename":"SocialLink","type":"MASTODON","url":"https://m.webtoo.ls/@astro"},{"__typename":"SocialLink","type":"LINKEDIN","url":"https://www.linkedin.com/company/withastro"},{"__typename":"SocialLink","type":"YOUTUBE","url":"https://www.youtube.com/@astrodotbuild"}],"location":null,"tags":["open source"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Thu Aug 12 2021 22:36:03 GMT+0000 (Coordinated Universal Time)","settings":{"features":{"conversations":true},"githubRepo":"snowpackjs/astro","moderation":{"rejectedCategories":[]},"expenseTypes":{"GRANT":true},"collectivePage":{"background":{"crop":{"x":-506,"y":259},"zoom":"2.12","mediaSize":{"width":1073,"height":565},"isAlignedRight":true},"primaryColor":"#297EFF"},"payoutsTwoFactorAuth":{"enabled":false,"rollingLimit":1000000},"disableCryptoContributions":false,"disableCustomContributions":false,"disablePublicExpenseSubmission":false},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":10,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://opencollective-production.s3.us-west-1.amazonaws.com/account-avatar/30121ce4-ec67-4aaa-9a8e-41562eef9ba3/astro-with-bg.png","imageUrl({\"height\":256})":"https://images.opencollective.com/astrodotbuild/2acbd39/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["GRANT","INVOICE","RECEIPT"],"features":{"__ref":"CollectiveFeatures:8k03reyd-5agmq5en-g4eqlbwo-z7j4nxv9"},"memberOf({\"limit\":1,\"onlyActiveCollectives\":true})":[{"__ref":"Member:288896"}],"stats":{"__ref":"CollectiveStatsType:422209"},"memberOf({\"limit\":1,\"role\":\"CONNECTED_COLLECTIVE\"})":[],"parentCollective":null,"host":{"__ref":"Organization:11004"},"contributors({\"roles\":[\"ADMIN\",\"MEMBER\"]})":[{"__ref":"Contributor:1272278"},{"__ref":"Contributor:35303"},{"__ref":"Contributor:447207"},{"__ref":"Contributor:256515"},{"__ref":"Contributor:541291"},{"__ref":"Contributor:12866"},{"__ref":"Contributor:245113"},{"__ref":"Contributor:610614"},{"__ref":"Contributor:940538"}],"contrib