e\":true,\"includePastEvents\":true})":[],"projects":[],"members({\"role\":\"ADMIN\"})":[{"__ref":"Member:1766"},{"__ref":"Member:1767"},{"__ref":"Member:1768"},{"__ref":"Member:614166"},{"__ref":"Member:778856"}],"members({\"role\":\"CONNECTED_COLLECTIVE\"})":[],"plan":{"__ref":"PlanType:302"}},"ROOT_QUERY":{"__typename":"Query","Collective({\"slug\":\"webpack\",\"throwIfMissing\":false})":{"__ref":"Collective:302"},"transactions({\"account\":{\"slug\":\"webpack\"},\"host\":{\"slug\":\"opensource\"},\"includeChildrenTransactions\":true,\"includeEditedReversedTransactions\":false,\"includeGiftCardTransactions\":true,\"includeIncognitoTransactions\":true,\"kind\":[\"ADDED_FUNDS\",\"BALANCE_TRANSFER\",\"CONTRIBUTION\",\"EXPENSE\",\"PLATFORM_TIP\"],\"limit\":3})":{"__typename":"TransactionCollection","offset":0,"limit":3,"nodes":[{"__ref":"Credit:b8f13a03-2060-426e-83cf-88c25045ae83"},{"__ref":"Credit:552700e1-7519-4ba1-af35-dfedc09c15cd"},{"__ref":"Credit:91dbc368-d7ef-48eb-89ef-e74dee0c5e86"}]},"expenses({\"account\":{\"slug\":\"webpack\"},\"includeChildrenExpenses\":true,\"limit\":3})":{"__typename":"ExpenseCollection","totalCount":912,"nodes":[{"__ref":"Expense:ex_7MgITvQSgChHqYYIbIxHv"},{"__ref":"Expense:ex_jCiE0t1i0iO30LCpcqKLU"},{"__ref":"Expense:ex_vCzCsGNr8e9Zl12Kktgfz"}]},"account({\"slug\":\"webpack\"})":{"__ref":"Collective:wov349mr-wgz75lpy-mzpa08dj-eybknoxd"}},"Host:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k":{"__typename":"Host","id":"8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k","name":"Open Source Collective","slug":"opensource","type":"ORGANIZATION","isTrustedHost":true,"isFirstPartyHost":true,"isVerified":false,"hasPublicProfile":true,"accountingCategories":{"__typename":"AccountingCategoryCollection","nodes":[{"__ref":"AccountingCategory:xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj"},{"__ref":"AccountingCategory:703k0exg-znm8yj64-n9q5wao9-r7b4dlvr"},{"__ref":"AccountingCategory:xggnxdwz-j3le5mpw-nvpy8rvb-ko04a97b"},{"__ref":"AccountingCategory:dlk9mbw7-y48r3zq3-nd60ej5l-avnodgx7"},{"__ref":"AccountingCategory:ynmlo94z-n7x08dpo-03pewga3-vjbrky5m"},{"__ref":"AccountingCategory:78a47byg-9nxozdp8-xb6mjlv0-3rek5w8k"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-ybq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-jmq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-kw6y870m-gkbrvdn8"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-xeqy870m-gkbrvdn8"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-xkpmj9no-8agdbe57"},{"__ref":"AccountingCategory:m5ax8emk-7lnw54q7-axqgyvj0-o93zdrbn"},{"__ref":"AccountingCategory:y7mywxoz-3409rl6k-kb6venbd-j7gk85ag"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-emqmj9no-8agdbe57"},{"__ref":"AccountingCategory:388rzown-xl9e50px-xbpymvbd-gk7j43a9"},{"__ref":"AccountingCategory:388rzown-xl9e50px-n3qymvbd-gk7j43a9"},{"__ref":"AccountingCategory:acat_ISbfB99gPLtNKJDmzGijM"}]},"legacyId":11004,"legalName":"Open Source Collective","currency":"USD","isHost":true,"expensePolicy":"\u003cdiv\u003e\u003cstrong\u003eFile an invoice only when you are requesting payment for services you personally performed.\u003c/strong\u003e We can only pay the individual who completed the work -- no third parties or friends. The person who performed the work must be the owner of the account receiving payment.\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eWe have \u003cstrong\u003estrict requirements\u003c/strong\u003e for what we can and cannot process. Certain information is \u003cstrong\u003erequired\u003c/strong\u003e on all invoices, and we cannot process payment if required information is missing.\u0026nbsp;\u003c/div\u003e\u003cdiv\u003ePlease review our full policies before submitting:\u003cbr\u003e\u003ca href=\"https://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\"\u003ehttps://docs.oscollective.org/for-hosted-member-projects/spending-money-and-getting-paid\u003c/a\u003e\u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003eIf your expense is missing required information or documentation, you will be asked to revise it before processing can begin. \u0026nbsp;\u003cbr\u003e\u003cbr\u003e\u003c/div\u003e\u003cdiv\u003e\u003cstrong\u003eProcessing and Payment:\u0026nbsp;\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eExpenses are processed \u003cstrong\u003etwice weekly\u003c/strong\u003e after approval by a Collective administrator and a secondary OSC review\u003c/li\u003e\u003cli\u003ePayments are made via \u003cstrong\u003ePayPal or Wise (bank transfer)\u003c/strong\u003e\u003c/li\u003e\u003cli\u003ePayments are limited to countries supported by these providers\u003c/li\u003e\u003cli\u003eIf you use PayPal, you may be required to complete a \u003cstrong\u003eKYC\u003c/strong\u003e process\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003eAn uploaded invoice is \u003cstrong\u003enot required\u003c/strong\u003e -- the information entered in the expense form is sufficient.\u003cbr\u003e If you choose to upload an invoice, address it to:\u003cbr\u003e \u003cbr\u003e\u003cstrong\u003eCollective/Project Name, Open Source Collective\u003c/strong\u003e\u003cbr\u003e 440 N. Barranca Avenue #3939\u003cbr\u003e Covina, CA 91723, USA\u003c/div\u003e","website":"https://oscollective.org/","settings":{"kyc":{"skipRequestIntroduction":true},"tos":"https://docs.google.com/document/u/1/d/e/2PACX-1vQbiyK2Fe0jLdh4vb9BfHY4bJ1LCo4Qvy0jg9P29ZkiC8y_vKJ_1fNgIbV0p6UdvbcT8Ql1gVto8bf9/pub","beta":{"embedContributionFlow":true},"apply":true,"goals":[{}],"budget":{"version":"v2"},"editor":"html","invoice":{"templates":{"default":{"info":"EIN 82-2037583\n\nThis payment is not deductible as a charitable contribution for U.S. federal income tax purposes.\n\nIf you have any need for a refund, please see our refund policy (below) and send an email to hello@oscollective.org\nhttps://docs.oscollective.org/for-donors-companies-organizations-and-individuals/refund-requests#refund-requests","title":""}},"expenseTemplates":{"default":{}}},"features":{"privacyVcc":true,"hostVendors":true,"transferwise":true,"virtualCards":true,"paypalPayouts":true,"stripePaymentIntent":true,"multiCurrencyExpenses":true},"feesOnTop":true,"moderation":{"rejectedCategories":[]},"earlyAccess":{"activityLog":true},"applyMessage":"If you can't authenticate using \u003e100 GitHub stars, please explain how you meet the alternative criteria: https://www.oscollective.org/#criteria","expenseTypes":{"GRANT":false,"INVOICE":true,"RECEIPT":true},"transferwise":{"ott":false,"transferDetails":true},"virtualcards":{"policy":"\u003cdiv\u003eVirtual cards are debit card numbers issued to OSC's hosted collectives for paying online expenses like recurring vendor payments, online resources or tools, and subscriptions. They are tied directly to a collective's budget on the Open Collective platform.\u003c/div\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eHOW IT WORKS\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are spent only as transactions occur. (Setting up a card does not remove any money from your initiative's budget.)\u003c/li\u003e\u003cli\u003eSubmit a virtual card request with the intended use of the card \u003cstrong\u003e(please specify the names of the services you will use) \u003c/strong\u003eand the amount budgeted for that use monthly \u003cstrong\u003e(e.g. $300/month)\u003c/strong\u003e. We will review your request and reply with any questions.\u003c/li\u003e\u003cli\u003eIf your collective needs a higher limit on your virtual card please request a limit increase by contacting us at hello@oscollective.org\u003cstrong\u003e \u003c/strong\u003ewith the intended use and the amount increase needed.\u003c/li\u003e\u003cli\u003eTo receive an increase, the project must have a budget on their Open Collective account that exceeds the corresponding amount and must demonstrate that a higher limit is necessary.\u003c/li\u003e\u003cli\u003eCards must be used in compliance with our policy below.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eELIGIBILITY\u003c/strong\u003e\u003cbr\u003eOSC reviews each virtual card request individually. When determining eligibility, we consider:\u003c/div\u003e\u003cul\u003e\u003cli\u003eHow long the project has been hosted by OSC\u003c/li\u003e\u003cli\u003eWhether the project is in good standing with OSC\u003c/li\u003e\u003cli\u003eThe requesting admin’s history with OSC\u003c/li\u003e\u003cli\u003eThe project’s available balance and transaction history\u003c/li\u003e\u003cli\u003eThe project's typical incoming contributions and outgoing expenses\u003c/li\u003e\u003cli\u003eThe anticipated monthly spending amount\u003c/li\u003e\u003cli\u003eThe proposed use of the card\u003cbr\u003e\u003cbr\u003e\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cstrong\u003eREQUIREMENTS/POLICY\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eThese are \u003cstrong\u003evirtual cards. \u003c/strong\u003eNo physical card will be issued, so these cannot be used in-store.\u003c/li\u003e\u003cli\u003eAll transactions should comply with normal usage of initiative funds as outlined in our \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/getting-started/terms\"\u003eTerms of Fiscal Sponsorship\u003c/a\u003e\u003c/li\u003e\u003cli\u003eIf a card has not been used for more than 15 months, the card will be frozen\u003c/li\u003e\u003cli\u003eAdmins requesting a card must have their legal name and address on file on their individual Open Collective user profile (not the collective's profile). Only the display name is public; legal name and address are visible only to OSC as fiscal host.\u003c/li\u003e\u003cli\u003eIf no receipt has been uploaded to an expense after 30 days, the card will be frozen\u003c/li\u003e\u003cli\u003e​Admins are personally liable for misuse\u0026nbsp;\u003c/li\u003e\u003cli\u003eVirtual cards \u003cstrong\u003emay not \u003c/strong\u003ebe used for \u003ca href=\"https://app.gitbook.com/o/-LWSZizNMEjL8_DrMNdF/s/-M9Neg20-zKzu0MhF2d2/how-it-works/payouts\"\u003epaying/reimbursing people\u003c/a\u003e, that should be done on the OC platform.\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eREQUESTING A CARD\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eOnly project admin's can request a card. \u003cstrong\u003e\u0026nbsp;\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eLog in to the Open Collective platform. In the left navigation, click on Virtual Cards -\u0026gt; Request a Card\u003c/li\u003e\u003cli\u003eOSC will assign the card (please allow time for processing)\u003c/li\u003e\u003cli\u003eOnce assigned, the card assignee will be notified via email and the card's details will appear in the initiative's Settings for you to use (in accordance with this policy)\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eCARDHOLDER CONTACT DETAILS:\u003c/strong\u003e\u003cbr\u003eIf you need to input Cardholder contact details/address:\u003c/div\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eName\u003c/strong\u003e: Open Source Collective\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eAddress\u003c/strong\u003e: 440 N Barranca Ave #3939 Covina, CA 91723, USA\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e\u003cdiv\u003e\u003cbr\u003e\u003cstrong\u003eAFTER A PURCHASE IS MADE\u003c/strong\u003e\u003c/div\u003e\u003cul\u003e\u003cli\u003eFunds are withdrawn from your initiative immediately.\u003c/li\u003e\u003cli\u003eAn \"Invitation to submit an expense\" will be sent to your initiative admins\u003c/li\u003e\u003cli\u003eAdmins will be asked to submit your receipt\u0026nbsp;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eIf the receipt is not submitted within 30 days, the card access will be paused until you do submit the receipt\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e","reminder":true,"autopause":true,"requestcard":true,"autopauseUnusedCards":{"period":455,"enabled":true}},"cryptoEnabled":false,"collectivePage":{"sections":[{"name":"CONTRIBUTIONS","type":"CATEGORY","sections":[{"name":"contributions","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"recurring-contributions","type":"SECTION","isEnabled":false,"restrictedTo":[]}],"isEnabled":true},{"name":"ABOUT","type":"CATEGORY","sections":[{"name":"about","type":"SECTION","isEnabled":true,"restrictedTo":null},{"name":"our-team","type":"SECTION","isEnabled":true,"restrictedTo":null}],"isEnabled":true},{"name":"CONTRIBUTE","type":"CATEGORY","sections":[{"name":"contribute","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"top-financial-contributors","type":"SECTION","isEnabled":true},{"name":"connected-collectives","type":"SECTION","isEnabled":false},{"name":"events","type":"SECTION","version":1,"isEnabled":false,"restrictedTo":[]},{"name":"contributors","type":"SECTION","isEnabled":true},{"name":"projects","type":"SECTION","version":1,"isEnabled":true,"restrictedTo":[]}],"isEnabled":true},{"name":"CONNECT","type":"CATEGORY","sections":[{"name":"updates","type":"SECTION","isEnabled":true,"restrictedTo":[]},{"name":"conversations","type":"SECTION","isEnabled":false,"restrictedTo":null}],"isEnabled":true},{"name":"BUDGET","type":"CATEGORY","sections":[{"name":"budget","type":"SECTION","version":2,"isEnabled":true,"restrictedTo":[]},{"name":"transactions","type":"SECTION","isEnabled":true}],"isEnabled":true}],"showGoals":false,"tiersOrder":["custom",118,119,15445],"primaryColor":"#663299","useNewSections":true,"legacySectionsBackup":[{"section":"about","isEnabled":true},{"section":"contributions","isEnabled":true},{"section":"contributors","isEnabled":true},{"section":"updates","isEnabled":false},{"section":"conversations","isEnabled":false},{"section":"transactions","isEnabled":true},{"section":"recurring-contributions","isEnabled":false,"restrictedTo":[]},{"section":"contribute","isEnabled":true,"restrictedTo":[]},{"section":"budget","isEnabled":true,"restrictedTo":[]}]},"hostCollective":{"id":11004},"paymentMethods":{"manual":{"title":"Bank Transfer (manual)","legacy":true,"features":{"recurring":false},"instructions":"Note: the instructions for transfers differ depending on whether you're sending from a US or non-US bank.\n\nMake sure to include the reference number, Invoice #, or project receiving the funds in the memo field.\n\nIf you have any questions or need an Invoice, please get in touch with us at hello@oscollective.org\n\n-------------------------------------\n\nFor US transfers (ACH or Wire)\n\nAmount: {amount}\nReference: {reference}\n\nAccount Number: 202525828483\nABA / Routing: 091311229\nSWIFT: CHFGUS44021\n\nAccount type: Business Checking\nBank name: Choice Financial Group\nBank address: 4501 23rd Avenue S, Fargo, ND 58104, USA\n\nAccount name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nInternational Bank Transfers (Wire)\nFor non-U.S. banks\n\nAmount: {amount}\nReference: {reference}\n\nRouting / Wire Number: 123205054\nSWIFT / BIC: UMPQUS6P\n\nAccount type: Business Checking\nBank Name: Columbia Bank\nBank Address: 450 Sansome St., Suite 120, San Francisco, CA 94111, United States\n\nAccount Name: Open Source Collective\nRecipient Address: 440 N Barranca Ave #3939 Covina, CA 91723, USA\n\n-------------------------------------\n\nPlease note that it will take 3~5 business days to process your payment. If you don't see your contribution within a week, please contact us at hello@oscollective.org. \n\nNOTE: WE DO NOT ACCEPT CHECKS"}},"payoutsTwoFactorAuth":{"enabled":true,"rollingLimit":1000000},"newPlatformTipsLedger":true,"forceNewPaypalPayments":true,"disableCryptoContributions":false,"exportedTransactionsFieldSets":{"yptc":{"name":"YPTC","fields":["effectiveDate","legacyId","description","type","kind","group","netAmount","currency","isRefund","isRefunded","refundLegacyId","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","orderMemo","expenseType","payoutMethodType","accountingCategoryCode","accountingCategoryName","merchantId","paymentProcessorFee","taxAmount","shortId","shortGroup","shortRefundId","displayAmount","amount","balance"],"useFieldNames":false,"flattenTaxesAndPaymentProcessorFees":true},"a-team":{"name":"A Team","fields":["datetime","shortId","shortGroup","description","type","kind","isRefund","isRefunded","shortRefundId","displayAmount","amount","paymentProcessorFee","netAmount","balance","currency","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","paymentMethodService","paymentMethodType","expenseType","expenseTags","payoutMethodType","merchantId","orderMemo","taxAmount","refundLegacyId","accountingCategoryName","accountingCategoryCode","effectiveDate","legacyId","group","debitAndCreditAmounts"],"flattenTaxesAndPaymentProcessorFees":true},"yptc-id-to-group":{"name":"YPTC - ID to Group","fields":["datetime","shortId","shortGroup"],"useFieldNames":false,"flattenTaxesAndPaymentProcessorFees":false},"yptc-new-export-draft":{"name":"YPTC - New Export Draft","fields":["effectiveDate","description","type","kind","merchantId","amount","netAmount","paymentProcessorFee","paymentMethodType","paymentMethodService","accountSlug","accountName","oppositeAccountSlug","oppositeAccountName","orderMemo","expenseType","accountingCategoryCode","accountingCategoryName","orderLegacyId","expenseLegacyId","isReverse","displayAmount","currency","isReversed","reverseKind","datetime","importSourceName","importSourceId","importSourceDescription","importSourceData","accountType","parentAccountSlug","oppositeParentAccountSlug"],"useFieldNames":true,"flattenTaxesAndPaymentProcessorFees":true}},"disablePublicExpenseSubmission":false,"exportedHostedCollectivesFieldSets":{"terminationnotice":{"name":"TerminationNotice","fields":["name","slug","website","adminCount","adminEmails","balance","lastContributionDate","valueOfContributionsAllTime","lastExpenseDate"]},"inactive-collectives-(for-2-years)":{"name":"Inactive collectives (for 2 years)","fields":["name","slug","type","approvedAt","balance","adminCount","adminEmails","lastContributionDate","lastExpenseDate","totalNumberOfContributions"]}},"autoAssignExpenseCategoryPredictions":true},"features":{"__ref":"CollectiveFeatures:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"location":{"__ref":"Location:288932"},"transferwise":{"__ref":"TransferWise:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"supportedPayoutMethods":["ACCOUNT_BALANCE","BANK_ACCOUNT","STRIPE","PAYPAL","OTHER"],"plan":{"__ref":"HostPlan:8a47byg9-nxozdp80-xm6mjlv0-3rek5w8k"},"accountingCategories({\"kind\":\"EXPENSE\"})":{"__typename":"AccountingCategoryCollection","nodes":[{"__ref":"AccountingCategory:xrmvrwng-4kj03dpb-xl6z57oy-l9e8xbaj"},{"__ref":"AccountingCategory:703k0exg-znm8yj64-n9q5wao9-r7b4dlvr"},{"__ref":"AccountingCategory:xggnxdwz-j3le5mpw-nvpy8rvb-ko04a97b"},{"__ref":"AccountingCategory:dlk9mbw7-y48r3zq3-nd60ej5l-avnodgx7"},{"__ref":"AccountingCategory:ynmlo94z-n7x08dpo-03pewga3-vjbrky5m"},{"__ref":"AccountingCategory:78a47byg-9nxozdp8-xb6mjlv0-3rek5w8k"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-ybq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:3vjrkx5l-mnv904qj-jmq8bwa7-zdygoe3d"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-kw6y870m-gkbrvdn8"},{"__ref":"AccountingCategory:oeejoxl3-az45w9pa-xeqy870m-gkbrvdn8"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-xkpmj9no-8agdbe57"},{"__ref":"AccountingCategory:m5ax8emk-7lnw54q7-axqgyvj0-o93zdrbn"},{"__ref":"AccountingCategory:y7mywxoz-3409rl6k-kb6venbd-j7gk85ag"},{"__ref":"AccountingCategory:z53kzxy4-v07wlr6m-emqmj9no-8agdbe57"},{"__ref":"AccountingCategory:388rzown-xl9e50px-xbpymvbd-gk7j43a9"},{"__ref":"AccountingCategory:388rzown-xl9e50px-n3qymvbd-gk7j43a9"},{"__ref":"AccountingCategory:acat_ISbfB99gPLtNKJDmzGijM"}]},"policies":{"__ref":"Policies:8a47byg9-nxozdp80-xm6mjlv