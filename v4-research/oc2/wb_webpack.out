":"backer","description":"Support us with a monthly donation and help us continue our activities.","useStandalonePage":false,"goal":null,"interval":"month","currency":"USD","amount":1000,"minimumAmount":200,"button":"Become a backer","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:266"},"contributors({\"limit\":4})":[{"__ref":"Contributor:7410"},{"__ref":"Contributor:12671"},{"__ref":"Contributor:4261"},{"__ref":"Contributor:7617"}]},"ContributorsStats:267":{"__typename":"ContributorsStats","id":"267","all":227,"users":56,"organizations":165},"TierStatsType:267":{"__typename":"TierStatsType","id":267,"availableQuantity":2147483647,"totalDonated":114273755,"totalRecurringDonations":540000,"contributors":{"__ref":"ContributorsStats:267"}},"Tier:{\"id\":267}":{"__typename":"Tier","id":267,"name":"Sponsor","slug":"sponsor","description":"Become a sponsor with a monthly donation of at least $200","useStandalonePage":true,"goal":null,"interval":"month","currency":"USD","amount":20000,"minimumAmount":20000,"button":"Become a bronze sponsor","amountType":"FLEXIBLE","endsAt":null,"type":"TIER","maxQuantity":null,"stats":{"__ref":"TierStatsType:267"},"contributors({\"limit\":4})":[{"__ref":"Contributor:6060"},{"__ref":"Contributor:5422"},{"__ref":"Contributor:217395"},{"__ref":"Contributor:4087"}]},"Member:1766":{"__typename":"Member","id":1766},"Member:1767":{"__typename":"Member","id":1767},"Member:1768":{"__typename":"Member","id":1768},"Member:614166":{"__typename":"Member","id":614166},"Member:778856":{"__typename":"Member","id":778856},"PlanType:302":{"__typename":"PlanType","id":302,"hostedCollectives":0},"Collective:302":{"__typename":"Collective","id":302,"idV2":"wov349mr-wgz75lpy-mzpa08dj-eybknoxd","slug":"webpack","path":"/webpack","name":"webpack","hasHosting":false,"description":"webpack is THE build solution for modern web applications.","longDescription":"\u003cp\u003eThe main purpose is to bundle JavaScript files for usage in a browser, yet it is also capable of transforming, bundling, or packaging just about any deployment target running javascript (node, electron, atom, web, web worker).\u003c/p\u003e\n\u003cp\u003eWebpack bundles both ES6, CommonJS, and AMD modules (even combined). In addition to code-splitting, webpack can create a single bundle or multiple chunks that are asynchronously loaded at runtime (to reduce initial loading time). Dependencies are resolved during compilation reducing the runtime size.\u003c/p\u003e\n\u003cp\u003eLoaders can preprocess files while compiling, e.g. coffeescript to JavaScript, handlebars strings to compiled functions, images to Base64, etc. webpack makes no assumption about your workflow, framework of choice, or development environment, and because of that, we are in the top 1% most used packages on npm!!!\u003c/p\u003e\n\u003cp\u003eWebpack has a highly modular and configurable plugin system that lets you do whatever else your application requires.\u003c/p\u003e\n\u003cp\u003eThis Collective is run by and for the benefit of the independent contributors to the webpack open source software project. This Collective is not endorsed or administered by OpenJS Foundation, Inc. (the “OpenJS Foundation”), the OpenJS Foundation does not receive and has no control over any funds contributed, the OpenJS Foundation does not direct or otherwise supervise the actions of any contributor to the webpack project, and all donations made will be expended for the private benefit of or otherwise to reimburse individuals that do not have an employer/employee, contractor, or other agency relationship with the OpenJS Foundation. The webpack marks used herein are used under license from the OpenJS Foundation for the benefit of the open source software community.\u003c/p\u003e","backgroundImage":"https://cl.ly/2b1k0P030J3o/webpack-background-image.jpg","backgroundImageUrl":"https://images.opencollective.com/webpack/ecb7672/background.jpg","twitterHandle":"webpack","repositoryUrl":"https://github.com/webpack","website":"https://webpack.js.org/","socialLinks":[{"__typename":"SocialLink","type":"WEBSITE","url":"https://webpack.js.org/"},{"__typename":"SocialLink","type":"TWITTER","url":"https://twitter.com/webpack"},{"__typename":"SocialLink","type":"GITHUB","url":"https://github.com/webpack"},{"__typename":"SocialLink","type":"DISCORD","url":"http://discord.gg/webpack"}],"location":{"__ref":"LocationType:47153"},"tags":["open source"],"company":null,"type":"COLLECTIVE","currency":"USD","createdAt":"Sun Oct 02 2016 23:30:48 GMT+0000 (Coordinated Universal Time)","settings":{"goals":[{"key":5895,"type":"yearlyBudget","title":"1 FT Maintainer + 50% Payouts","amount":51000000,"description":"This yearly budget is needed to pay the current amount of github contributions with a rate of $50/hour. Contributors will start receiving payouts when crossing the threshold of $300. This goal assumes that the contribution amount doesn't increase."},{"key":86273,"type":"yearlyBudget","title":"50% Payouts","amount":25500000,"description":"This yearly budget is needed to pay the current amount of github contributions with 50% of a rate of $50/hour. Contributors will start receiving payouts when crossing the threshold of $300. This goal assumes that the contribution amount doesn't increase."},{"key":80067,"type":"yearlyBudget","title":"1 FT + 100% Payouts","amount":76500000,"description":"This yearly budget is needed to pay the current amount of github contributions with a rate of $50/hour. Contributors will start receiving payouts when crossing the threshold of $300. This goal assumes that the contribution amount will grow by 50%."},{"key":64155,"type":"yearlyBudget","title":"2FT + 100% Payouts","amount":100000000,"description":"This yearly budget is needed to pay the current amount of github contributions with a rate of $50/hour. Contributors will start receiving payouts when crossing the threshold of $300. This goal assumes that the contribution amount will grow by 50%."}],"style":{"hero":{"cover":{"filter":""}}},"editor":"html","githubOrg":"webpack","moderation":{"rejectedCategories":[]},"payoutsTwoFactorAuth":{"enabled":false,"rollingLimit":1000000},"disablePublicExpenseSubmission":false},"isActive":true,"isApproved":true,"isVerified":false,"isArchived":false,"isFrozen":false,"isSuspended":false,"isHost":false,"isIncognito":false,"isGuest":false,"isTrustedHost":false,"isFirstPartyHost":false,"hostFeePercent":10,"platformFeePercent":0,"platformContributionAvailable":true,"image":"https://cl.ly/221T14472V23/icon-big_x6ot1e.png","imageUrl({\"height\":256})":"https://images.opencollective.com/webpack/c517443/logo/256.png","canApply":false,"canContact":true,"supportedExpenseTypes":["INVOICE","RECEIPT"],"features":{"__ref":"CollectiveFeatures:wov349mr-wgz75lpy-mzpa08dj-eybknoxd"},"memberOf({\"limit\":1,\"onlyActiveCollectives\":true})":[{"__ref":"Member:67396"}],"stats":{"__ref":"CollectiveStatsType:302"},"memberOf({\"limit\":1,\"role\":\"CONNECTED_COLLECTIVE\"})":[],"parentCollective":null,"host":{"__ref":"Organization:11004"},"contributors({\"roles\":[\"ADMIN\",\"MEMBER\"]})":[{"__ref":"Contributor:3624"},{"__ref":"Contributor:5923"},{"__ref":"Contributor:2005"},{"__ref":"Contributor:5693"},{"__ref":"Contributor:4745"}],"contributors({\"limit\":150,\"roles\":[\"BACKER\"]})":[{"__ref":"Contributor:6060"},{"__ref":"Contributor:5422"},{"__ref":"Contributor:217395"},{"__ref":"Contributor:4087"},{"__ref":"Contributor:4409"},{"__ref":"Contributor:38231"},{"__ref":"Contributor:238806"},{"__ref":"Contributor:6767"},{"__ref":"Contributor:9337"},{"__ref":"Contributor:5954"},{"__ref":"Contributor:16284"},{"__ref":"Contributor:2309"},{"__ref":"Contributor:23903"},{"__ref":"Contributor:464082"},{"__ref":"Contributor:71987"},{"__ref":"Contributor:7410"},{"__ref":"Contributor:30807"},{"__ref":"Contributor:69553"},{"__ref":"Contributor:35382"},{"__ref":"Contributor:27721"},{"__ref":"Contributor:114241"},{"__ref